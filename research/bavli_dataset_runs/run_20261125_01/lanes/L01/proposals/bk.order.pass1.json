  "records": [
    {
      "content": {
        "boundary": "closed",
        "legacy_ids": [],
        "primary": true,
        "title": "סדר המשנה והמקור להתחיל בקריאת שמע בערב"
      },
      "evidence": [
        {
          "end_char": 57,
          "quote": "<big><strong>גמ׳</strong></big> תנא היכא קאי דקתני מאימתי",
          "segment_id": "seg_53d5eea0c7415cc00767",
          "start_char": 0
        },
        {
          "end_char": 47,
          "quote": "ותו מאי שנא דתני בערבית ברישא לתני דשחרית ברישא",
          "segment_id": "seg_89c3f1b14efeb0de146c",
          "start_char": 0
        },
        {
          "end_char": 101,
          "quote": "תנא אקרא קאי דכתיב בשכבך ובקומך והכי קתני זמן קריאת שמע דשכיבה אימת משעה שהכהנים נכנסין לאכול בתרומתן",
          "segment_id": "seg_14a303ff961bf4a85d73",
          "start_char": 0
        },
        {
          "end_char": 66,
          "quote": "ואי בעית אימא יליף מברייתו של עולם דכתיב ויהי ערב ויהי בקר יום אחד",
          "segment_id": "seg_21080d7ae52960c91e68",
          "start_char": 0
        },
        {
          "end_char": 104,
          "quote": "אי הכי סיפא דקתני בשחר מברך שתים לפניה ואחת לאחריה ובערב מברך שתים לפניה ושתים לאחריה לתני דערבית ברישא.",
          "segment_id": "seg_260000b714277eafa776",
          "start_char": 0
        },
        {
          "end_char": 85,
          "quote": "תנא פתח בערבית והדר תני בשחרית עד דקאי בשחרית פריש מילי דשחרית והדר פריש מילי דערבית:",
          "segment_id": "seg_5763c01691003b6e5f6f",
          "start_char": 0
        }
      ],
      "id": "bk.order.pass1.s",
      "layer": "structure",
