רה כולה אומרים לפניו רבש\"ע כלום יש אב שמעיד על בנו דכתיב (שמות ד, כב) בני בכורי ישראל אמר להם הקב\"ה שמים וארץ יעידו בהם שקיימו את התורה כולה","segment_id":"seg_6eb63be013f0073ae001","start_char":0},{"end_char":289,"quote":"אומרים לפניו רבש\"ע שמים וארץ נוגעין בעדותן שנאמ' (ירמיהו לג, כה) אם לא בריתי יומם ולילה חוקות שמים וארץ לא שמתי (דאר\"ש) [ואר\"ש] בן לקיש מאי דכתיב (בראשית א, לא) ויהי ערב ויהי בקר יום הששי מלמד שהתנה הקב\"ה עם מעשה בראשית ואמר אם ישראל מקבלין את תורתי מוטב ואם לאו אני אחזיר אתכם לתוהו ובוהו","segment_id":"seg_06db261f8002810c2146","start_char":0},{"end_char":134,"quote":"והיינו דאמר חזקיה מאי דכתיב (תהלים עו, ט) משמים השמעת דין ארץ יראה ושקטה אם יראה למה שקטה ואם שקטה למה יראה אלא בתחלה יראה ולבסוף שקטה","segment_id":"seg_bdbb58fd452f00b01707","start_char":0},{"end_char":189,"quote":"אמר להם הקב\"ה מכם יבאו ויעידו בהן בישראל שקיימו את התורה כולה יבא נמרוד ויעיד באברהם שלא עבד עבודת כוכבים יבא לבן ויעיד ביעקב שלא נחשד על הגזל תבא אשת פוטיפרע ותעיד ביוסף שלא נחשד על העבירה","segment_id":"seg_35751675db13d708ae47","start_char":0},{"end_char":242,"quote":"יבא נבוכד נצר ויעיד בחנניה מישאל ועזריה שלא השתחוו לצלם יבא דריוש ויעיד בדניאל שלא ביטל את התפלה יבא בלדד השוחי וצופר הנעמתי ואליפז התימני ואליהו בן ברכאל הבוזי ויעידו בהם בישראל שקיימו את כל התורה כולה שנאמר (ישעיהו מג, ט) יתנו עידיהם ויצדקו","segment_id":"seg_ef3e9d77ca06f0b79219","start_char":0},{"end_char":181,"quote":"אמרו לפניו רבש\"ע תנה לנו מראש ונעשנה אמר להן הקב\"ה שוטים שבעולם מי שטרח בערב שבת יאכל בשבת מי שלא טרח בערב שבת מהיכן יאכל בשבת אלא אף על פי כן מצוה קלה יש לי וסוכה שמה לכו ועשו אותה","segment_id":"seg_89bddcca1fea22f8e6b7","start_char":0},{"end_char":144,"quote":"ומי מצית אמרת הכי והא אמר רבי יהושע בן לוי מאי דכתיב (דברים ז, יא) אשר אנכי מצוך היום היום לעשותם ולא למחר לעשותם היום לעשותם ולא היום ליטול שכר","segment_id":"seg_fe4df8ae681f1aed8e59","start_char":0},{"end_char":83,"quote":"אלא שאין הקב\"ה בא בטרוניא עם בריותיו ואמאי קרי ליה מצוה קלה משום דלית ביה חסרון כיס","segment_id":"seg_10c7e0cb784185de770d","start_char":0},{"end_char":260,"quote":"מיד כל אחד [ואחד] נוטל והולך ועושה סוכה בראש גגו והקדוש ברוך הוא מקדיר עליהם חמה בתקופת תמוז וכל אחד ואחד מבעט בסוכתו ויוצא שנאמר (תהלים ב, ג) ננתקה את מוסרותימו ונשליכה ממנו עבותימו מקדיר והא אמרת אין הקדוש ברוך הוא בא בטרוניא עם בריותיו משום דישראל נמי זימני","segment_id":"seg_bdd6bce1c60628e466bf","start_char":0},{"end_char":96,"quote":"דמשכא להו תקופת תמוז עד חגא והוי להו צערא והאמר רבא מצטער פטור מן הסוכה נהי דפטור בעוטי מי מבעטי","segment_id":"seg_d25c3ed0aeebc37727ea","start_char":0},{"end_char":114,"quote":"מיד הקב\"ה יושב ומשחק עליהן שנאמר (תהלים ב, ד) יושב בשמים ישחק וגו' א\"ר יצחק אין שחוק לפני הקב\"ה אלא אותו היום בלבד","segment_id":"seg_3113286c1c57affb8383","start_char":0}],"id":"az.s05","layer":"structure","links":[],"ml_eligible":false,"origin":"editorial_inference","release_state":"valid","review_state":"unreviewed","uncertainty":[]},{"content":{"boundary":"closed","legacy_ids":[],"primary":false,"title":"ערעור על עדי ישראל והעמדת עדים מן האומות"},"evidence":[{"end_char":70,"quote":"אלא כך אומרים העובדי כוכבים לפני הקב\"ה רבש\"ע ישראל שקיבלוה היכן קיימוה","segment_id":"seg_5e642d24153b5e919a98","start_char":0},{"end_char":180,"quote":"אמר להם הקב\"ה אני מעיד בהם שקיימו את התורה כולה אומרים לפניו רבש\"ע כלום יש אב שמעיד על בנו דכתיב (שמות ד, כב) בני בכורי ישראל אמר להם הקב\"ה שמים וארץ יעידו בהם שקיימו את התורה כולה","segment_id":"seg_6eb63be013f0073ae001","start_char":0},{"end_char":289,"quote":"אומרים לפניו רבש\"ע שמים וארץ נוגעין בעדותן שנאמ' (ירמיהו לג, כה) אם לא בריתי יומם ולילה חוקות שמים וארץ לא שמתי (דאר\"ש) [ואר\"ש] בן לקיש מאי דכתיב (בראשית א, לא) ויהי ערב ויהי בקר יום הששי מלמד שהתנה הקב\"ה עם מעשה בראשית ואמר אם ישראל מקבלין את תורתי מוטב ואם לאו אני אחזיר אתכם לתוהו ובוהו","segment_id":"seg_06db261f8002810c2146","start_char":0},{"end_char":134,"quote":"והיינו דאמר חזקיה מאי דכתיב (תהלים עו, ט) משמים השמעת דין ארץ יראה ושקטה אם יראה למה שקטה ואם שקטה למה יראה אלא ב