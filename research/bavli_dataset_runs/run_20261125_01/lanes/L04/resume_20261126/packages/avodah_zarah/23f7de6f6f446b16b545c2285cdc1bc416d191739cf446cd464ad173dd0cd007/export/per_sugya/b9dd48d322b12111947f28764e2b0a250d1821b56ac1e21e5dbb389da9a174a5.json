 יעשה אותם האדם וחי בהם כהנים לוים וישראלים לא נאמר אלא האדם הא למדת שאפילו עובד כוכבים ועוסק בתורה הרי הוא ככהן גדול","segment_id":"seg_bc85b14c99ff12b8f30e","start_char":0},{"end_char":128,"quote":"אלא לומר לך שאין מקבלין עליהם שכר כמצווה ועושה אלא כמי שאינו מצווה ועושה דאמר ר' חנינא גדול המצווה ועושה יותר משאינו מצווה ועושה","segment_id":"seg_7f8a4d26c7de9c451feb","start_char":0}],"id":"az.s04","layer":"structure","links":[],"ml_eligible":false,"origin":"editorial_inference","release_state":"valid","review_state":"unreviewed","uncertainty":[]},{"content":{"boundary":"closed","legacy_ids":[],"primary":false,"title":"ניסוח מחדש של טענת האומות על קבלת תורה"},"evidence":[{"end_char":184,"quote":"אומרים לפניו רבש\"ע כלום נתת לנו ולא קיבלנוה ומי מצי למימר הכי והכתי' (דברים לג, ב) ויאמר ה' מסיני בא וזרח משעיר למו וכתיב (חבקוק ג, ג) אלוה מתימן יבוא וגו' מאי בעי בשעיר ומאי בעי בפארן","segment_id":"seg_07706aff7620295a1710","start_char":0},{"end_char":79,"quote":"א\"ר יוחנן מלמד שהחזירה הקב\"ה על כל אומה ולשון ולא קבלוה עד שבא אצל ישראל וקבלוה","segment_id":"seg_71cce6bc7d32b297ff48","start_char":0},{"end_char":147,"quote":"אלא הכי אמרי כלום קיבלנוה ולא קיימנוה ועל דא תברתהון אמאי לא קבלתוה אלא כך אומרים לפניו רבש\"ע כלום כפית עלינו הר כגיגית ולא קבלנוה כמו שעשית לישראל","segment_id":"seg_7bad119d62331832f8c4","start_char":0},{"end_char":153,"quote":"דכתיב (שמות יט, יז) ויתיצבו בתחתית ההר ואמר רב דימי בר חמא מלמד שכפה הקב\"ה הר כגיגית על ישראל ואמר להם אם אתם מקבלין את התורה מוטב ואם לאו שם תהא קבורתכם","segment_id":"seg_1b1552250474be90e268","start_char":0}],"id":"az.s04a","layer":"structure","links":[],"ml_eligible":false,"origin":"editorial_inference","release_state":"valid","review_state":"unreviewed","uncertainty":[]},{"content":{"composition":"atomic","discourse_role":"טענה ראשונית הנדחית","textual_voice":"האומות בתוך הדרשה"},"evidence":[{"end_char":43,"quote":"אומרים לפניו רבש\"ע כלום נתת לנו ולא קיבלנוה","segment_id":"seg_07706aff7620295a1710","start_char":0}],"id"