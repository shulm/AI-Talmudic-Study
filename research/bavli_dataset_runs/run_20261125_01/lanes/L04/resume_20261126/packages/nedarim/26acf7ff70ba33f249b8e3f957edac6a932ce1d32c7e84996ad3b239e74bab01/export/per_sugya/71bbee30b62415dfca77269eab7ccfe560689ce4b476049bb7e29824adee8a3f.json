 כותב להדיוט ומה בין כותב לנשיא לכותב להדיוט הכותב לנשיא אין צריך לזכות והכות' להדיוט צריך לזכות וחכמים אומרים אחד זה ואחד זה צריכים לזכות לא דברו בנשיא אלא בהוה:","segment_id":"seg_3ec695e7c7f251f131f9","start_char":0},{"end_char":166,"quote":"ר' יהודה אומר אין אנשי גליל צריכין לזכות שכבר כתבו אבותיהן על ידיהן: תניא ר' יהודה אומר אנשי גליל קנטרנין היו והיו נודרין הנאה זה מזה עמדו אבותיהם וכתבו חלקיהן לנשיא:","segment_id":"seg_7f0afcd2554e27ed4b50","start_char":0}],"id":"nd.r048.community","layer":"structure","links":[],"ml_eligible":false,"origin":"editorial_inference","release_state":"valid","review_state":"unreviewed","uncertainty":[]}}
