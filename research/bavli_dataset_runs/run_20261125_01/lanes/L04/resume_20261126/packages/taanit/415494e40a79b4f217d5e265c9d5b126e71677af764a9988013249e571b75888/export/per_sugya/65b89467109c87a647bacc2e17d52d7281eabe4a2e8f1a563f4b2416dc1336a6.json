חלה נתקלל נחש ואחר כך נתקללה חוה ואח\"כ נתקלל אדם","segment_id":"seg_6390afa68cc606b5b74f","start_char":0},{"end_char":62,"quote":"הא חשיבותא לדידהו דאמרי להו אתון חשיביתו למיבעי עלן רחמי אכ\"ע:","segment_id":"seg_77dd834dfc7a494bacaa","start_char":0},{"end_char":204,"quote":"(כל אחד ואחד (נוטל ונותן) בראשו אמר רב אדא) וכל אחד ואחד (נוטל ונותן) בראשו נשיא ואב בית דין נמי נשקלו אינהו ונינחו בראשייהו מאי שנא דשקיל איניש אחרינא ומנח להו אמר רבי אבא דמן קסרי אינו דומה מתבייש מעצמו","segment_id":"seg_88b883853b7a60e749e6","start_char":0},{"end_char":113,"quote":"למתבייש מאחרים והיכא מנח להו אמר רבי יצחק במקום תפילין שנאמר (ישעיהו סא, ג) לשום לאבילי ציון לתת להם פאר תחת אפר:","segment_id":"seg_b385f2f7751e591a2633","start_char":0}],"id":"ta.resume031.structure.ritualscope","layer":"structure","links":[],"ml_eligible":false,"origin":"editorial_inference","release_state":"valid","review_state":"unreviewed","uncertainty":[]},{"content":{"assertion_mode":"asserted","conditions":[],"proposition":"Rabbi Yitzhak places them at the tefillin location.","scope":"Taanit 16a:1 local discussion"},"evidence":[{"end_char":54,"quote":"אמר רבי יצחק במקום תפילין","segment_id":"seg_b385f2f7751e591a2633","start_char":29}],"id":"ta.resume031.tefillin.place","layer":"claims","links":[],"ml_eligible":false,"origin":"source_paraphrase","release_state":"valid","review_state":"unreviewed","uncertainty":[]},{"content":{"candidates":["Rabbi Yitzhak"],"role":"speaker","scope":"ta.resume031.tefillin.place","surface":"Rabbi Yitzhak","transmission_chain":[]},"evidence":[{"end_char":54,"quote":"אמר רבי יצחק במקום תפילין","segment_id":"seg_b385f2f7751e591a2633","start_char":29}],"id":"ta.resume031.tefillin.place.a","layer":"attributions","links":["ta.resume031.tefillin.place"],"ml_eligible":false,"origin":"source_paraphrase","release_state":"valid","review_state":"unreviewed","uncertainty":[]},{"content":{"claim_id":"ta.resume031.tefillin.place","conditions":[],"holder_candidates":["Rabbi Yitzhak"],"local