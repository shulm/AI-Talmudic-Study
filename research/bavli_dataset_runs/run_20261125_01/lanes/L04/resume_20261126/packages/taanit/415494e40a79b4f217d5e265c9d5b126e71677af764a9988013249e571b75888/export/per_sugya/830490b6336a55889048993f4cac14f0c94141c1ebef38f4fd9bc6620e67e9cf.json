course_role":"asserted","textual_voice":"Mishnah"},"evidence":[{"end_char":119,"quote":"על אלו מתריעין בכל מקום על השדפון ועל הירקון ועל הארבה ועל החסיל ועל החיה רעה ועל החרב מתריעין עליה מפני שהיא מכה מהלכת","segment_id":"seg_bd0ed47305e4286c2e99","start_char":0}],"id":"ta.resume038.spreading.afflictions.u","layer":"utterances","links":["ta.resume038.spreading.afflictions"],"ml_eligible":false,"origin":"source_paraphrase","release_state":"valid","review_state":"unreviewed","uncertainty":["Enumerated composite, not atomic evaluation sample."]},{"content":{"boundary":"closed","legacy_ids":[],"primary":true,"title":"Mishnah: immediate alarms, spreading afflictions and Sabbath exceptions"},"evidence":[{"end_char":175,"quote":"מתני׳ <big><strong>סדר</strong></big> תעניות אלו האמור ברביעה ראשונה אבל צמחים ששנו מתריעין עליהן מיד וכן שפסקו גשמים בין גשם לגשם ארבעים יום מתריעין עליהן מפני שהיא מכת בצורת","segment_id":"seg_e775c0947d8a55e3ceea","start_char":0},{"end_char":207,"quote":"ירדו לצמחין אבל לא ירדו לאילן לאילן ולא לצמחין לזה ולזה אבל לא לבורות לשיחין ולמערות מתריעין עליהן מיד וכן עיר שלא ירדו עליה גשמים דכתיב (עמוס ד, ז) והמטרתי על עיר אחת ועל עיר אחת לא אמטיר חלקה אחת תמטר וגו'","segment_id":"seg_53c778613aca03aa0645","start_char":0},{"end_char":205,"quote":"אותה העיר מתענה ומתרעת וכל סביבותיה מתענות ולא מתריעות רבי עקיבא אומר מתריעות ולא מתענות וכן עיר שיש בה דבר או מפולת אותה העיר מתענה ומתרעת וכל סביבותיה מתענות ולא מתריעות רבי עקיבא אומר מתריעות ולא מתענות","segment_id":"seg_f928e6cc50a05556399d","start_char":0},{"end_char":105,"quote":"איזהו דבר עיר המוציאה חמש מאות רגלי ויצאו ממנה ג' מתים בג' ימים זה אחר זה הרי זה דבר פחות מכאן אין זה דבר","segment_id":"seg_1a46fc94ab77613d0525","start_char":0},{"end_char":119,"quote":"על אלו מתריעין בכל מקום על השדפון ועל הירקון ועל הארבה ועל החסיל ועל החיה רעה ועל החרב מתריעין עליה מפני שהיא מכה מהלכת","segment_id":"seg_bd0ed47305e4286c2e99","start_char":0},{"end_char":174,"quote":"מעשה שירדו זקנים מירושלים לעריהם וגזרו תענית על שנראה כמלא פי תנור שדפון באשקלון ועוד גזרו תענית על שאכלו זאבים שני תינוקות בעבר הירדן רבי יוסי אומר לא על שאכלו אלא על שנראו:","segment_id":"seg_5ca9e695de05be4e0786","start_char":0},{"end_char":147,"quote":"על אלו מתריעין בשבת על עיר שהקיפוה נכרים או נהר ועל הספינה המיטרפת בים ר' יוסי אומר לעזרה ולא לצעקה שמעון התימני אומר אף על הדבר ולא הודו לו חכמים:","segment_id":"seg_689bf5b6a7876f259ee2","start_char":0}],"id":"ta.resume038.structure.distress","layer":"structure","links":[],"ml_eligible":false,"origin":"editorial_inference","release_state":"valid","review_state":"unreviewed","uncertainty":[]},{"content":{"assertion_mode":"asserted","conditions":[],"proposition":"They also decreed a fast because wolves ate two children across the Jordan.","scope":"Taanit 19a:4 local discussion"},"evidence":[{"end_char":134,"quote":"ועוד גזרו תענית על שאכלו זאבים שני תינוקות בעבר הירדן","segment_id":"seg_5ca9e695de05be4e0786","start_char":81}],"id":"ta.resume038.wolves.children","layer":"claims","links":[],"ml_eligible":false,"origin":"source_paraphrase","release_state":"valid","review_state":"unreviewed","uncertainty":[]},{"content":{"candidates":[],"role":"anonymous","scope":"ta.resume038.wolves.children","surface":"anonymous","transmission_chain":[]},"evidence":[{"end_char":134,"quote":"ועוד גזרו תענית על שאכלו זאבים שני תינוקות בעבר הירדן","segment_id":"seg_5ca9e695de05be4e0786","start_char":81}],"id":"ta.resume038.wolves.children.a","layer":"attributions","links":["ta.resume038.wolves.children"],"ml_eligible":false,"origin":"source_paraphrase","release_state":"valid","review_state":"unreviewed","uncertainty":[]},{"content":{"claim_id":"ta.resume038.wolves.children","conditions":[],"holder_candidates":[],"local_status":"asserted locally; no later halakhic adjudication inferred","question_id":null},"evidence":[{"end_char":134,"quote":"ועוד גזרו תענית על שאכלו זאבים שני תינוקות בעבר הירדן","segment_id":"seg_5ca9e695de05be4e0786","start_char":81}],"id":"ta.resume038.wolv