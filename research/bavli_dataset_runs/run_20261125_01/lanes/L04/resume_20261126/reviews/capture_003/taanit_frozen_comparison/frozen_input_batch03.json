  "source_read": [
    {
      "nonempty_ordinal": 129,
      "ref": "Taanit 6a:13",
      "page_index": 10,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 73,
      "quote": "בשלמא רביעה ראשונה לשאול שלישית להתענות שניה למאי אמר ר' זירא לנדרים דתנן",
      "quote_sha256": "bc21dc2c97927e562bae87c819f019a17f2d37da7eed2e197ed7043841c8a38f"
    },
    {
      "nonempty_ordinal": 130,
      "ref": "Taanit 6b:1",
      "page_index": 11,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 47,
      "quote": "הנודר עד הגשמים משירדו גשמים עד שתרד רביעה שניה",
      "quote_sha256": "0022751392470b246d5072d0af2ed68b6e0e0d86ac8d1d0b3a02fb436a308253"
    },
    {
      "nonempty_ordinal": 131,
      "ref": "Taanit 6b:2",
      "page_index": 11,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 139,
      "quote": "רב זביד אמר לזיתים דתנן מאימתי כל אדם מותרין בלקט בשכחה ובפאה משילכו הנמושות בפרט ובעוללות משילכו עניים בכרם ויבואו בזיתים משתרד רביעה שניה",
      "quote_sha256": "74dab22bbf2ced71dda4703ea5673e71a1132ab74fdb16cd6cef2fe7da44a556"
    },
    {
      "nonempty_ordinal": 132,
      "ref": "Taanit 6b:3",
      "page_index": 11,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 64,
      "quote": "מאי נמושות אמר ר' יוחנן סבי דאזלי אתיגרא ר\"ל אמר לקוטי בתר לקוטי",
      "quote_sha256": "417555e8f455f6714231f77bf30c9136ad665accc6ba17aead17d45257cdf8b8"
    },
    {
      "nonempty_ordinal": 133,
      "ref": "Taanit 6b:4",
      "page_index": 11,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 86,
      "quote": "רב פפא אמר כדי להלך בשבילי הרשות דאמר מר מהלכין כל אדם בשבילי הרשות עד שתרד רביעה שניה",
      "quote_sha256": "3cd70444c0e19e0b84134319e05e561ba5a2568af4be507a580773624a98f15b"
    },
    {
      "nonempty_ordinal": 134,
      "ref": "Taanit 6b:5",
      "page_index": 11,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 102,
      "quote": "רב נחמן בר יצחק אמר לבער פירות שביעית דתנן עד מתי נהנין ושורפין בתבן ובקש של שביעית עד שתרד רביעה שניה",
      "quote_sha256": "8ea5bded9649de2c2ac3858a4502473b371a4f0254d4a95d9a2e2aa0501f1765"
    },
    {
      "nonempty_ordinal": 135,
      "ref": "Taanit 6b:6",
      "page_index": 11,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 128,
      "quote": "מאי טעמא דכתיב (ויקרא כה, ז) ולבהמתך ולחיה אשר בארצך כל זמן שחיה אוכלת בשדה האכל לבהמתך בבית כלה לחיה מן השדה כלה לבהמתך מן הבית",
      "quote_sha256": "5f07c63d2ca8ecdd81ffec1721edd4ce2710c5a10d525b1168271f0933828786"
    },
    {
      "nonempty_ordinal": 136,
      "ref": "Taanit 6b:7",
      "page_index": 11,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 193,
      "quote": "אמר רבי אבהו מאי לשון רביעה דבר שרובע את הקרקע כדרב יהודה דאמר רב יהודה מיטרא בעלה דארעא הוא שנאמר (ישעיהו נה, י) כי כאשר ירד הגשם והשלג מן השמים ושמה לא ישוב כי אם הרוה את הארץ והולידה והצמיחה",
      "quote_sha256": "57133648330ad6624b74e2fb8bac63e99ff91281506e4f54c9f7ad3837bea94e"
    },
    {
      "nonempty_ordinal": 137,
      "ref": "Taanit 6b:8",
      "page_index": 11,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 133,
      "quote": "ואמר רבי אבהו רביעה ראשונה כדי שתרד בקרקע טפח שניה כדי לגוף בה פי חבית אמר רב חסדא גשמים שירדו כדי לגוף בהן פי חבית אין בהן משום ועצר",
      "quote_sha256": "e9faca9aa8c85e9f3cd265bbd08c6fa6596b8db3ab53d8670eb58b25f64ad042"
    },
    {
      "nonempty_ordinal": 138,
      "ref": "Taanit 6b:9",
      "page_index": 11,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 52,
      "quote": "ואמר רב חסדא גשמים שירדו קודם ועצר אין בהן משום ועצר",
      "quote_sha256": "2e2ab02bfb9754e2e36ccc16227db7df055866a7b7c5c8dd35e25a5addde28ec"
    },
    {
      "nonempty_ordinal": 139,
      "ref": "Taanit 6b:10",
      "page_index": 11,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 197,
      "quote": "אמר אביי לא אמרן אלא קודם ועצר דאורתא אבל קודם ועצר דצפרא יש בהן משום ועצר דאמר רב יהודה בר יצחק הני ענני דצפרא לית בהו מששא דכתיב (הושע ו, ד) מה אעשה לך אפרים מה אעשה לך יהודה וחסדכם כענן בקר וגו'",
      "quote_sha256": "792a8e9d94730c77d6505bad99481dd09a3a5862dda64fdde4ab3fece1c104c3"
    },
    {
      "nonempty_ordinal": 140,
      "ref": "Taanit 6b:11",
      "page_index": 11,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 106,
      "quote": "א\"ל רב פפא לאביי והא אמרי אינשי במפתח בבי מיטרא בר חמרא מוך שקך וגני לא קשיא הא דקטיר בעיבא הא דקטיר בענני",
      "quote_sha256": "3b641ae74242fad802d68ce02186063dfd7a484990d9ce44626b301e209124bd"
    }
  ],
