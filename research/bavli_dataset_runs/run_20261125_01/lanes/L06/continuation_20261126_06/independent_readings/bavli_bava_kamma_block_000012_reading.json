  "blind_to_producer_labels": true,
  "core_segments": 10,
  "context_segments": 31,
  "evidence": [
    {
      "ref": "Bava Kamma 4b:5",
      "page_index": 7,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 114,
      "quote": "תני רב אושעיא שלשה עשר אבות נזיקין שומר חנם והשואל נושא שכר והשוכר נזק צער וריפוי שבת ובושת וארבעה דמתני' הא תליסר",
      "sha256_utf8": "b572ff6675d8a77932fc629340f6b536dd2d33778531b5090a8e32a74d6c2cac",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 4b:6",
      "page_index": 7,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 112,
      "quote": "ותנא דידן מ\"ט לא תני הני בשלמא לשמואל בנזקי ממון קמיירי בנזקי גופו לא קמיירי אלא לרב ליתני תנא אדם וכל מילי דאדם",
      "sha256_utf8": "22281f5c5f8f12613b9abbd05e4ecbb89b75c101a87e647ac4ea33048e5b92b9",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 4b:7",
      "page_index": 7,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 81,
      "quote": "ולר' אושעיא נמי הא תני ליה אדם תרי גווני אדם תנא אדם דאזיק אדם ותנא אדם דאזיק שור",
      "sha256_utf8": "e3d3649980e5108a39f2d765fd6a57e0496f9bee8ce6cd002d3c7fffb25b29f5",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 4b:8",
      "page_index": 7,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 75,
      "quote": "אי הכי שור נמי ליתני תרי גווני שור ליתני שור דאזיק שור וליתני שור דאזיק אדם",
      "sha256_utf8": "e8c816e2ad464ac19bd342f8b441b627417fe21570f53ed2e6090402eb217cda",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 4b:9",
      "page_index": 7,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 145,
      "quote": "האי מאי בשלמא אדם דאזיק שור נזק הוא דמשלם אדם דאזיק אדם משלם ארבעה דברים אלא שור מה לי שור דאזיק שור מה לי שור דאזיק אדם אידי ואידי נזק הוא דמשלם",
      "sha256_utf8": "c8d1eece22c43a55035f07c22baa3a5a0ace87a9ecf41fe999c94f442a51dba8",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 4b:10",
      "page_index": 7,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 60,
      "quote": "והא שומר חנם והשואל נושא שכר והשוכר דאדם דאזיק שור הוא וקתני",
      "sha256_utf8": "647ea4c4759a2a1c8e8f2ebb3270b14ac850cca298527071ab169e71c3bf9865",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 4b:11",
      "page_index": 7,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 35,
      "quote": "תני הזיקא דבידים וקתני הזיקא דממילא",
      "sha256_utf8": "2115123366792c51846dfa99ca637dd443e20c0f5e2abbe7dfc2dd521cc92313",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 4b:12",
      "page_index": 7,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 91,
      "quote": "תני ר' חייא עשרים וארבעה אבות נזיקין תשלומי כפל ותשלומי ארבעה וחמשה וגנב וגזלן ועדים זוממין",
      "sha256_utf8": "b281f948e4c6dea19bdd2bf050b97d45002e2757eb0ff975c233e27734683281",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 4b:13",
      "page_index": 7,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 74,
      "quote": "והאונס והמפתה ומוציא שם רע והמטמא והמדמע והמנסך והני תליסר הא עשרים וארבעה",
      "sha256_utf8": "13770e46275b596e94b0d899125f755c83adbdd1e062a977d518af349956e0fa",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 4b:14",
      "page_index": 7,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 61,
      "quote": "ורבי אושעיא מאי טעמא לא תני הני בממונא קמיירי בקנסא לא קמיירי",
      "sha256_utf8": "f7847b96b158e60bb99d37df13978c24fd49f35c7539db5d6967b2639ab283cc",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 4b:15",
      "page_index": 7,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 54,
      "quote": "גנב וגזלן דממונא הוא ליתני הא קתני ליה שומר חנם והשואל",
      "sha256_utf8": "64566010714467cabc786579317ae9a4d0fdc4437a4462abe59904ceb9b7d3e8",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 4b:16",
      "page_index": 7,
      "segment_index": 15,
      "start_char": 0,
      "end_char": 100,
      "quote": "ורבי חייא נמי הא תנא ליה שומר חנם והשואל תני ממונא דאתא לידיה בהיתירא וקתני ממונא דאתא לידיה באיסורא",
      "sha256_utf8": "ca819f7fa07b6eff55422002b0eb3392393e8ede5878137a6b19e8facebac757",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:1",
      "page_index": 8,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 67,
      "quote": "עדים זוממין דממונא הוא ליתני סבר לה כר\"ע דאמר אין משלמין על פי עצמן",
      "sha256_utf8": "7ffe020a7bb25b973b6ace8bfdebf8c3feabae6a6b80cee5f5fa6dc712b12c11",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:2",
      "page_index": 8,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 76,
      "quote": "אי סבר ליה כר\"ע ליתני תרי גווני שור ליתני שור דאזיק שור וליתני שור דאזיק אדם",
      "sha256_utf8": "02024a11ef1b0969543d7807adfa81ba9577ab8c7d8c98cb34558c5741cd44a6",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:3",
      "page_index": 8,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 48,
      "quote": "דתנן ר\"ע אומר אף תם שחבל באדם משלם במותר נזק שלם",
      "sha256_utf8": "4b534d1e15c38dbf08db695ac9e8e552e8b299367b213d4076a9fa97f9d6ebb0",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:4",
      "page_index": 8,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 136,
      "quote": "הא תבריה ר\"ע לגזיזיה דתניא ר\"ע אומר יכול אף תם שחבל באדם ישלם מן העלייה תלמוד לומר (שמות כא, לא) יעשה לו מגופו משלם ואינו משלם מן העלייה",
      "sha256_utf8": "edaf34ccd4161f11386a2909256fc636e211f5b1e0496bbd24a1270a74b6fc5e",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:5",
      "page_index": 8,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 43,
      "quote": "האונס והמפתה והמוציא שם רע דממונא הוא ליתני",
      "sha256_utf8": "1d5372aeea74bc40b4aea60d772286273f9c89b009da9796cab495dec362dc49",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:6",
      "page_index": 8,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 106,
      "quote": "מה נפשך אי נזק תנא ליה אי צער תנא ליה אי בשת תנא ליה אי פגם היינו נזק מה אית לך למימר קנסא בקנסא לא קמיירי",
      "sha256_utf8": "163f4a3da9dc1a99b61b6525564f90a2bf760a99366ca35abd3bec7081b14ff4",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:7",
      "page_index": 8,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 36,
      "quote": "המטמא והמדמע והמנסך דממונא הוא ליתני",
      "sha256_utf8": "beea36b8079af9b7e70d3b8f7cb9ef26c773b173a09b02d1da1e9ee6e7507018",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:8",
      "page_index": 8,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 113,
      "quote": "מה נפשך אי היזק שאינו ניכר שמיה היזק הא תנא ליה נזק אי היזק שאינו ניכר לא שמיה היזק הוה ליה קנסא ובקנסא לא קמיירי",
      "sha256_utf8": "b78fe593236e09fddb2b9f8923438c3ba6ab4613b2182e1329036bf9641029de",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:9",
      "page_index": 8,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 115,
      "quote": "לימא קסבר ר' חייא היזק שאינו ניכר לא שמיה היזק דאי שמיה היזק הא תנא ליה נזק תנא היזקא דמינכרא ותנא היזקא דלא מינכרא",
      "sha256_utf8": "4f206e2396ec98c3c9f46c20740d785d3fc684b8d34f38a0e7d54c1fd5957d7d",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:10",
      "page_index": 8,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 115,
      "quote": "בשלמא לתנא דידן תנא מניינא למעוטי דר' אושעיא ור' אושעיא תנא מניינא למעוטי דרבי חייא אלא מניינא דרבי חייא למעוטי מאי",
      "sha256_utf8": "3678f3fa97d136f58cb84c478d1402af9210230651c7f26fadddbe20653d7fcd",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:11",
      "page_index": 8,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 17,
      "quote": "למעוטי מוסר ומפגל",
      "sha256_utf8": "7a903ec365121eae7a2b8861f272daf8b0d84e6ec246172ab9c17e71036bbeaf",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:12",
      "page_index": 8,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 96,
      "quote": "וליתני בשלמא מפגל בקדשים לא קמיירי אלא מוסר מאי טעמא לא תני שאני מוסר דדיבורא ובדיבורא לא קמיירי",
      "sha256_utf8": "792a8396fec8438c5f92473685bfd8082ca0d0f96a3305831cb574048a03318e",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:13",
      "page_index": 8,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 58,
      "quote": "והא מוציא שם רע דדיבורא הוא וקתני דיבורא דאית ביה מעשה הוא",
      "sha256_utf8": "8f9dee902ef69b9c567b481329eaca9c862bfdfa30df38753609b423e1bbbf21",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:14",
      "page_index": 8,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 138,
      "quote": "והא עדים זוממין דיבורא דלית ביה מעשה הוא וקתני התם אע\"ג דלית ביה מעשה רחמנא קרייה מעשה דכתיב (דברים יט, יט) ועשיתם לו כאשר זמם לעשות לאחיו",
      "sha256_utf8": "c09638a281c9c2a6627d07eaee0f8fa89a734f0ac02fafbd86521202d8fe2c74",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:15",
      "page_index": 8,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 110,
      "quote": "בשלמא לתנא דידן תנא אבות מכלל דאיכא תולדות אלא לרבי חייא ורבי אושעיא אבות מכלל דאיכא תולדות תולדותיהן מאי ניהו",
      "sha256_utf8": "c5eb8ab7cdb51f8adcc99fc20317a3a5993057ed64d6e2de385c82b7ffc5f458",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5a:16",
      "page_index": 8,
      "segment_index": 15,
      "start_char": 0,
      "end_char": 34,
      "quote": "אמר רבי אבהו כולן כאבות לשלם ממיטב",
      "sha256_utf8": "db1643cc3b8263e10d9523d03c10b34f3b2d96e054286e402a246f8aad4caf4e",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 5a:17",
      "page_index": 8,
      "segment_index": 16,
      "start_char": 0,
      "end_char": 32,
      "quote": "מאי טעמא אתיא תחת נתינה ישלם כסף",
      "sha256_utf8": "d42db68c04991a3a6fa305410e0dfcc7999ae9e6f16a3dc30ab145b81ccf6718",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 5a:18",
      "page_index": 8,
      "segment_index": 17,
      "start_char": 0,
      "end_char": 121,
      "quote": "לא הרי השור כהרי המבעה מאי קאמר אמר רב זביד משמיה דרבא הכי קאמר לכתוב רחמנא חדא ותיתי אידך מיניה הדר אמר חדא מחדא לא אתיא",
      "sha256_utf8": "83a6ba56bca240461610347817a427302640ec87016edc0d69c1c7ec7f6c9f6c",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 5a:19",
      "page_index": 8,
      "segment_index": 18,
      "start_char": 0,
      "end_char": 70,
      "quote": "ולא זה וזה שיש בהן רוח חיים מאי קאמר אמר רב משרשיא משמיה דרבא הכי קאמר",
      "sha256_utf8": "ce83f68da122ec248d94adb55eda25ec7d92189dcccd99c6b9f9147b560314e6",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 5b:1",
      "page_index": 9,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 60,
      "quote": "לכתוב רחמנא תרתי ותיתי אידך מינייהו הדר אמר חדא מתרתי לא אתי",
      "sha256_utf8": "f1b5b14e256d461214b86b1850f351a92c2f8ccaef47712c1f4081eab49d9dc0",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 5b:2",
      "page_index": 9,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 109,
      "quote": "אמר רבא וכולהו כי שדית בור בינייהו אתיא כולהו במה הצד לבר מקרן משום דאיכא למיפרך מה לכולהו שכן מועדין מתחילתן",
      "sha256_utf8": "56adc32bdcdce6c0717ac24d79afd9e377a2c82fca6e6131ffdb44e7a89ed7b4",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 5b:3",
      "page_index": 9,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 59,
      "quote": "ולמאן דאמר אדרבה קרן עדיפא שכוונתו להזיק אפילו קרן נמי אתיא",
      "sha256_utf8": "73abf0316253bcaf1226d868f12d8aa9c15b3a203cf5d711ed9e8eb452936936",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 5b:4",
      "page_index": 9,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 38,
      "quote": "אלא למאי הלכתא כתבינהו רחמנא להלכותיהן",
      "sha256_utf8": "a67868650fcc6021ecc8706cfa3be01d2f68b264e06344e77931ee0722977abf",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 5b:5",
      "page_index": 9,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 23,
      "quote": "קרן לחלק בין תמה למועדת",
      "sha256_utf8": "35b8a5c6ec1792f795d46c105e5862daed4988f7840a0c8c68706bb4210ce00e",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 5b:6",
      "page_index": 9,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 26,
      "quote": "שן ורגל לפוטרן ברשות הרבים",
      "sha256_utf8": "1b95a25bf8e1985796944e56935597a68ddbdd0cafbcb4a96f69967227b2b9d6",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 5b:7",
      "page_index": 9,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 75,
      "quote": "בור לפטור בו את הכלים ולרבי יהודה דמחייב על נזקי כלים בבור לפטור בו את האדם",
      "sha256_utf8": "372136ed8d26a87e2dcff16d8e5200ae01daed571758bf1ce334c54c47eff959",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 5b:8",
      "page_index": 9,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 23,
      "quote": "אדם לחייבו בארבעה דברים",
      "sha256_utf8": "6accd56de9bb2231f68bd2e08ef518cb3df960041925113a0afa1debd03fa1ee",
      "cohort": "context_expansion"
    },
    {
