      "ref": "Niddah 3b:3",
      "page_index": 5,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 18,
      "quote": "לרבא איכא מוך דחוק",
      "sha256_utf8": "ea736d2ed989298c38b4e395d79eb2178ea6ff6d740a2b169f93db774d19f3f3",
      "cohort": "context_expansion"
    },
    {
      "ref": "Niddah 3b:4",
