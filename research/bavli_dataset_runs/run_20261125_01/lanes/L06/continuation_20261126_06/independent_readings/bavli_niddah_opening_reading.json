      "ref": "Niddah 3b:11",
      "page_index": 5,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 85,
      "quote": "אמר ליה א\"כ בטלת בנות ישראל מפריה ורביה והלל מפריה ורביה מי קאמינא לטהרות הוא דקאמינא",
      "sha256_utf8": "924c103c124f390b0e9bff2be2bcd7637522800c834aab0c04528c27c60d6c19",
      "cohort": "context_expansion"
