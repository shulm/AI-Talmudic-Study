      "start_char": 0,
      "end_char": 36,
      "quote": "והשתא דאוקי אשן רגל דאזלה ממילא מנלן",
      "sha256_utf8": "b2a8a4894f8d23b47a1897aa6a646bdce11ff96d8c5e036e8146525366cdf201",
      "cohort": "context_expansion"
    },
    {
