  "source_sha256": "1867903e8e200a22b7931d936bfdd6cc2fb9fc032c425427cba695944650fd87",
  "plan_sha256": "12ce5b3cf8801f05fef09105ad8ace65b538f227c7c2dfcf51a92219a6f5050b",
  "block_id": "block_000013",
  "roles": [
    "probability_sample"
  ],
  "blind_to_producer_labels": true,
  "core_segments": 10,
  "context_segments": 22,
  "evidence": [
    {
      "ref": "Megillah 5a:5",
      "page_index": 8,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 96,
      "quote": "<big><strong>מתני׳</strong></big> אי זו היא עיר גדולה כל שיש בה עשרה בטלנין פחות מכאן הרי זה כפר",
      "sha256_utf8": "c310fc108c14dda45e6cbb2fd750fa316f13c3f14f5a145a06f3e2e3fccf64f9",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5a:6",
      "page_index": 8,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 87,
      "quote": "באלו אמרו מקדימין ולא מאחרין אבל זמן עצי כהנים ותשעה באב חגיגה והקהל מאחרין ולא מקדימין",
      "sha256_utf8": "777c65b1b9442038a5f203d38fe7acb5e8231acc9e00c7ca86cddd04854d2a54",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5a:7",
      "page_index": 8,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 174,
      "quote": "אע\"פ שאמרו מקדימין ולא מאחרין מותרין בהספד ובתענית ומתנות לאביונים א\"ר יהודה אימתי מקום שנכנסין בשני ובחמישי אבל מקום שאין נכנסין לא בשני ולא בחמישי אין קורין אותה אלא בזמנה:",
      "sha256_utf8": "b563e6575e3409fc8e5604db580994cdf1361cff5c702d6e9706349d2a87f623",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5a:8",
      "page_index": 8,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 60,
      "quote": "<big><strong>גמ׳</strong></big> תנא עשרה בטלנין שבבית הכנסת:",
      "sha256_utf8": "2dd32ffa91ca2a8dc2746247f6407add28649f15c2e06c85d8d8501e2f90fdea",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5a:9",
      "page_index": 8,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 73,
      "quote": "באלו אמרו מקדימין ולא מאחרין: מ\"ט אמר רבי אבא אמר שמואל אמר קרא ולא יעבור",
      "sha256_utf8": "4b2bd521e42004651317f868f77d3ef1bdd7ffe07b5f73947d4c55fe9c22729c",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5a:10",
      "page_index": 8,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 123,
      "quote": "ואמר רבי אבא אמר שמואל מנין שאין מונין ימים לשנים שנא' (שמות יב, ב) לחדשי השנה חדשים אתה מונה לשנים ואי אתה מונה ימים לשנים",
      "sha256_utf8": "44b218beef9ff7a8bf683fd5e16551621f627b8ba98894a53cf51601817c38d6",
      "cohort": "probability_core"
    },
    {
      "ref": "Megillah 5a:11",
      "page_index": 8,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 136,
      "quote": "ורבנן דקיסרי משום ר' אבא אמרו מנין שאין מחשבין שעות לחדשים שנא' (במדבר יא, כ) עד חדש ימים ימים אתה מחשב לחדשים ואי אתה מחשב שעות לחדשים:",
      "sha256_utf8": "1971458585de4c75e7bc763548a943c4c05c5581153e7b97e64b442b8e83017f",
      "cohort": "probability_core"
    },
    {
      "ref": "Megillah 5a:12",
      "page_index": 8,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 136,
      "quote": "אבל זמן עצי כהנים ותשעה באב וחגיגה והקהל מאחרין ולא מקדימין: תשעה באב אקדומי פורענות לא מקדמי חגיגה והקהל משום דאכתי לא מטא זמן חיובייהו",
      "sha256_utf8": "97616b96fd36eb005faede65b33c2bebd664a31de8bbb9f8fe3beffed469e899",
      "cohort": "probability_core"
    },
    {
      "ref": "Megillah 5a:13",
      "page_index": 8,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 101,
      "quote": "תנא חגיגה וכל זמן חגיגה מאחרין בשלמא חגיגה דאי מיקלע בשבתא מאחרינן לה לבתר שבתא אלא זמן חגיגה מאי היא",
      "sha256_utf8": "d8f4f64bab9a1b6ea495ce56bc9b21c7a9e9a6db729240d2db87da3971bc2aab",
      "cohort": "probability_core"
    },
    {
      "ref": "Megillah 5a:14",
      "page_index": 8,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 75,
      "quote": "אמר רב אושעיא הכי קאמר חגיגה בשבת ועולת ראייה אפילו ביו\"ט דזמן חגיגה מאחרין",
      "sha256_utf8": "5f3fcdc292ea29b8b451ae26ca14013851fbd9995c1e8c6a86ca4309ccb52956",
      "cohort": "probability_core"
    },
    {
      "ref": "Megillah 5a:15",
      "page_index": 8,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 66,
      "quote": "מני ב\"ש היא דתנן [ב\"ש אומרים] מביאין שלמים ביו\"ט ואין סומכין עליהן",
      "sha256_utf8": "d211532813013130faa321d62cd88041057cd549e3d38cbd4cc885b7a8495a8c",
      "cohort": "probability_core"
    },
    {
      "ref": "Megillah 5a:16",
      "page_index": 8,
      "segment_index": 15,
      "start_char": 0,
      "end_char": 58,
      "quote": "אבל לא עולות וב\"ה אומרים מביאין שלמים ועולות וסומכין עליהן",
      "sha256_utf8": "9ba398e6f6ce6267194fbe59d266391932eb90e1b6a64053cb4ebfbd177a8a26",
      "cohort": "probability_core"
    },
    {
      "ref": "Megillah 5a:17",
      "page_index": 8,
      "segment_index": 16,
      "start_char": 0,
      "end_char": 158,
      "quote": "רבא אמר חגיגה כל זמן חגיגה מאחרין טפי לא דתנן מי שלא חג ביו\"ט הראשון של חג חוגג והולך את כל הרגל כולו ויום טוב האחרון של חג עבר הרגל ולא חג אינו חייב באחריותו",
      "sha256_utf8": "a4262eddeba9aecb4f59249a5788f76ab0d208ec193760aa62bd76986211a837",
      "cohort": "probability_core"
    },
    {
      "ref": "Megillah 5a:18",
      "page_index": 8,
      "segment_index": 17,
      "start_char": 0,
      "end_char": 117,
      "quote": "רב אשי אמר חגיגה וכל זמן חגיגה מאחרין ואפי' עצרת דחד יומא מאחרין דתנן מודים שאם חל עצרת להיות בשבת שיום טבוח אחר השבת",
      "sha256_utf8": "54a541165eea1d9b0d56e491448d368803b59dbe9ffd1be457b13416527a7d85",
      "cohort": "probability_core"
    },
    {
      "ref": "Megillah 5a:19",
      "page_index": 8,
      "segment_index": 18,
      "start_char": 0,
      "end_char": 48,
      "quote": "אמר רבי אלעזר אמר רבי חנינא רבי נטע נטיעה בפורים",
      "sha256_utf8": "223891fb5425a59358faa98fa9e165039b208a93ac547ca89d4c3c80801cf3c3",
      "cohort": "probability_core"
    },
    {
      "ref": "Megillah 5b:1",
      "page_index": 9,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 68,
      "quote": "ורחץ בקרונה של צפורי בשבעה עשר בתמוז ובקש לעקור תשעה באב ולא הודו לו",
      "sha256_utf8": "8626fd404fe6643c22fd41e9bbe5f88d8a753ecbafa0fa7bb36304511bfd8b1f",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:2",
      "page_index": 9,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 177,
      "quote": "אמר לפניו רבי אבא בר זבדא רבי לא כך היה מעשה אלא תשעה באב שחל להיות בשבת הוה ודחינוהו לאחר השבת ואמר רבי הואיל ונדחה ידחה ולא הודו חכמים קרי עליה (קהלת ד, ט) טובים השנים מן האחד",
      "sha256_utf8": "9c1fff72009e77161dd180df936ec1941111924ec318ae288f59bfa723fc70a3",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:3",
      "page_index": 9,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 177,
      "quote": "ורבי היכי נטע נטיעה בפורים והתני רב יוסף שמחה ומשתה וי\"ט שמחה מלמד שאסורים בהספד משתה מלמד שאסור בתענית ויום טוב מלמד שאסור בעשיית מלאכה אלא רבי בר ארביסר הוה וכי נטע בחמיסר נטע",
      "sha256_utf8": "66626354bc8e2ffd89029a6da1a6bdf87778c4774fdccc402b7e4297fbbd3aa6",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:4",
      "page_index": 9,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 106,
      "quote": "איני והא רבי בטבריא הוה וטבריא מוקפת חומה מימות יהושע בן נון הואי אלא רבי בר חמיסר הוה וכי נטע בארביסר הוה",
      "sha256_utf8": "9d75bd16a1a6dacfd805bdacb41254795bd2a78274aa9b12cbd2d0542afc42ae",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:5",
      "page_index": 9,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 172,
      "quote": "ומי פשיטא ליה דטבריא מוקפת חומה מימות יהושע בן נון והא חזקיה קרי בטבריא בארביסר ובחמיסר מספקא ליה אי מוקפת חומה מימות יהושע בן נון היא אי לא לחזקיה מספקא ליה לרבי פשיטא ליה",
      "sha256_utf8": "8f61bc2572113ad07cd8e1bae1b4c2cfbcb35db77b99f7415bdc5c41dc07c64c",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:6",
      "page_index": 9,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 106,
      "quote": "וכי פשיטא ליה מי שרי והכתיב במגילת תענית את יום ארבעה עשר ואת יום חמשה עשר יומי פוריא אינון דלא למספד בהון",
      "sha256_utf8": "7c805e03411abe1734f53208eae70fe4addc905b05e94fb0e1996e0534cfc433",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:7",
      "page_index": 9,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 102,
      "quote": "ואמר רבא לא נצרכא אלא לאסור את של זה בזה ואת של זה בזה הני מילי בהספד ובתענית אבל מלאכה יום אחד ותו לא",
      "sha256_utf8": "4830b03b94c15713a08208140106857dfdffcc3203d90e772d6a83f4481bebd7",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:8",
      "page_index": 9,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 91,
      "quote": "איני והא רב חזייה לההוא גברא דהוה קא שדי כיתנא בפוריא ולטייה ולא צמח כיתניה התם בר יומא הוה",
      "sha256_utf8": "4ec8591a5949798c454a88d9d7d4ee81ed7abd5b7c1dbaef10500a99f68339cc",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:9",
      "page_index": 9,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 81,
      "quote": "רבה בריה דרבא אמר אפי' תימא ביומיה הספד ותענית קבילו עלייהו מלאכה לא קבילו עלייהו",
      "sha256_utf8": "8dba6f5a6b7e3bbfc30c39276c561128eb3a87bbe4daebcdd3d9cf11f0ba0d2b",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:10",
      "page_index": 9,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 114,
      "quote": "דמעיקרא כתיב (אסתר ט, יט) שמחה ומשתה ויום טוב ולבסוף כתיב (שם, כב) לעשות אותם ימי משתה ושמחה ואילו יום טוב לא כתיב",
      "sha256_utf8": "34eb23de3dc1f71b70658647eb1769399288a2f1014e56b91c3e851d3994d099",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:11",
      "page_index": 9,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 89,
      "quote": "ואלא רב מ\"ט לטייה לההוא גברא דברים המותרין ואחרים נהגו בהן איסור הוה ובאתריה דרבי לא נהוג",
      "sha256_utf8": "c21c073e08a899fb59261ea773fdef2ce0288c6f462c87a9e2c46de65e00fdfe",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:12",
      "page_index": 9,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 120,
      "quote": "ואיבעית אימא לעולם נהוג ורבי נטיעה של שמחה נטע כדתנן עברו אלו ולא נענו ממעטין במשא ומתן בבנין ובנטיעה באירוסין ובנישואין",
      "sha256_utf8": "31ff10c0eb1bc1dfbc8e2cac10b8d2e53d661e36a09da2db9d5d085ec1eb749b",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:13",
      "page_index": 9,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 138,
      "quote": "ותנא עלה בנין בנין של שמחה נטיעה נטיעה של שמחה איזהו בנין של שמחה זה הבונה בית חתנות לבנו איזו היא נטיעה של שמחה זה הנוטע אבורנקי של מלכים",
      "sha256_utf8": "1c236e10553e5699aa9ecce92507eaaea8ce7d04bdd4c675ea73162a2fe74312",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:14",
      "page_index": 9,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 245,
      "quote": "גופא חזקיה קרי בטבריא בארביסר ובחמיסר מספקא ליה אי מוקפת חומה מימות יהושע בן נון היא אי לא ומי מספקא ליה מלתא דטבריא והכתיב (יהושע יט, לה) וערי מבצר הצדים צר וחמת רקת וכנרת וקיימא לן רקת זו טבריא היינו טעמא דמספקא ליה משום דחד גיסא שורא דימא הות",
      "sha256_utf8": "785fab543e6c9d95599507d649fff3f694b0cc77df49cd70cdd030995ae1063a",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:15",
      "page_index": 9,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 111,
      "quote": "אי הכי אמאי מספקא ליה ודאי לאו חומה היא דתניא (ויקרא כה, ל) אשר לו חומה ולא שור איגר סביב פרט לטבריא שימה חומתה",
      "sha256_utf8": "e6770a36ed5c25265e6a3d27a54ffd158479f09848c95cdaa2bf5398f85a62ee",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:16",
      "page_index": 9,
      "segment_index": 15,
      "start_char": 0,
      "end_char": 225,
      "quote": "לענין בתי ערי חומה לא מספקא ליה כי קא מספקא ליה לענין מקרא מגילה מאי פרזים ומאי מוקפין דכתיבי גבי מקרא מגילה משום דהני מיגלו והני לא מיגלו והא נמי מיגליא או דלמא משום דהני מיגנו והני לא מיגנו והא נמי מיגניא משום הכי מספקא ליה",
      "sha256_utf8": "68cd820bc5f222e43a87171e85bd8394594158fd73bab403a75f9d55765d0d25",
      "cohort": "context_expansion"
    },
    {
      "ref": "Megillah 5b:17",
      "page_index": 9,
      "segment_index": 16,
      "start_char": 0,
      "end_char": 160,
      "quote": "רב אסי קרי מגילה בהוצל בארביסר ובחמיסר מספקא ליה אי מוקפת חומה מימות יהושע בן נון היא אי לא איכא דאמר אמר רב אסי האי הוצל דבית בנימין מוקפת חומה מימות יהושע היא",
      "sha256_utf8": "fd4d878035e69d6517c2826f987684073543b85b0d1db106dfd85b095036a186",
      "cohort": "context_expansion"
    }
  ],
  "claims": [
