      "page_index": 13,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 137,
      "quote": "ובקדשים קלים כולן להחמיר כיצד קדשים קלים לפני זריקת דמים אין מועלין לא באימורין ולא בבשר לאחר זריקת דמים מועלין באימורין ואין מועלין בבשר",
      "sha256_utf8": "b83e28aba004371e7c7428052e5fd0ad44ab282a01d420b845a943ade74ae8da",
      "cohort": "context_expansion"
    },
    {
