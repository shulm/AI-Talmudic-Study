  "core_segments": 10,
  "context_segments": 11,
  "evidence": [
    {
      "ref": "Niddah 21b:16",
      "page_index": 41,
      "segment_index": 15,
      "start_char": 0,
      "end_char": 139,
      "quote": "בעא מיניה רבי ירמיה מרבי זירא הרואה דם בשפופרת מהו (ויקרא טו:ז) בבשרה אמר רחמנא ולא בשפופרת או דלמא האי בבשרה מיבעי ליה שמטמאה מבפנים כבחוץ",
      "sha256_utf8": "ba91593abbb572faf4b07cf3104d5ac247c23532fc883eda402636a7d8c3b308",
      "cohort": "context_expansion"
    },
    {
      "ref": "Niddah 21b:17",
      "page_index": 41,
      "segment_index": 16,
      "start_char": 0,
      "end_char": 118,
      "quote": "אמר ליה בבשרה אמר רחמנא ולא בשפופרת דאי בבשרה מבעי ליה שמטמאה מבפנים כבחוץ א\"כ נימא קרא (בבשר) מאי בבשרה שמע מינה תרתי",
      "sha256_utf8": "1e65e9f90b5330a28516a51f40bb8863202770314f060f7c56565cedea7e7a87",
      "cohort": "context_expansion"
    },
    {
      "ref": "Niddah 21b:18",
      "page_index": 41,
      "segment_index": 17,
      "start_char": 0,
      "end_char": 88,
      "quote": "והא\"ר יוחנן משום רבי שמעון בן יוחי המפלת חתיכה קורעה אם יש בה דם אגור טמאה ואם לאו טהורה",
      "sha256_utf8": "4a4b32c55775fd93568777b4f7e9f52f6210f19e17b19f4a97c0a3578fbaea13",
      "cohort": "context_expansion"
    },
    {
      "ref": "Niddah 21b:19",
      "page_index": 41,
      "segment_index": 18,
      "start_char": 0,
      "end_char": 77,
      "quote": "הכי השתא התם דרכה של אשה לראות דם בחתיכה הכא אין דרכה של אשה לראות דם בשפופרת",
      "sha256_utf8": "312bf5f136673cc25316f9ea87ad6cf8b54f7ea4e04271eec47e652ef2c63237",
      "cohort": "context_expansion"
    },
    {
      "ref": "Niddah 21b:20",
      "page_index": 41,
      "segment_index": 19,
      "start_char": 0,
      "end_char": 131,
      "quote": "לימא שפופרת תנאי היא דתניא המפלת חתיכה אף על פי שמלאה דם אם יש עמה דם טמאה ואם לאו טהורה רבי אליעזר אומר בבשרה ולא בשפיר ולא בחתיכה",
      "sha256_utf8": "9b3e8047b33b2ff2706d231aa93a2e06a62d673a4adb166225d19845df829e37",
      "cohort": "context_expansion"
    },
    {
      "ref": "Niddah 21b:21",
      "page_index": 41,
      "segment_index": 20,
      "start_char": 0,
      "end_char": 72,
      "quote": "ר' אליעזר היינו תנא קמא אימא שרבי אליעזר אומר בבשרה ולא בשפיר ולא בחתיכה",
      "sha256_utf8": "4a1f1a424aac32682cd7db2d0ff04305ae646bcb45548369c6078b9e92aeb66e",
      "cohort": "context_expansion"
    },
    {
      "ref": "Niddah 21b:22",
      "page_index": 41,
      "segment_index": 21,
      "start_char": 0,
      "end_char": 91,
      "quote": "וחכמים אומרים אין זה דם נדה אלא דם חתיכה תנא קמא נמי טהורי מטהר אלא דפלי פלויי איכא בינייהו",
      "sha256_utf8": "c3363250bcb9ce2b2de1e1ae96a65fe3f41d96e6b2a493191331e8cb0c00eca0",
      "cohort": "context_expansion"
    },
    {
      "ref": "Niddah 21b:23",
      "page_index": 41,
      "segment_index": 22,
      "start_char": 0,
      "end_char": 122,
      "quote": "תנא קמא סבר בבשרה ולא בשפיר ולא בחתיכה והוא הדין לשפופרת והני מילי היכא דשיעא אבל פלי פלויי טמאה מאי טעמיה בבשרה קרינא ביה",
      "sha256_utf8": "b08bb1c211d9a598014ec345bc51e0da66c76eaa64604ed982a4253cffd0f6fc",
      "cohort": "context_expansion"
    },
    {
      "ref": "Niddah 21b:24",
      "page_index": 41,
      "segment_index": 23,
      "start_char": 0,
      "end_char": 100,
      "quote": "ואתו רבנן למימר אף על גב דפלי פלויי אין זה דם נדה אלא דם חתיכה הא דם נדה ודאי טמא ואפילו בשפופרת נמי",
      "sha256_utf8": "44322f5cbd57218416c9c0851cf8a6102db690d7aced840fb8486bd5c3e6e92c",
      "cohort": "probability_core"
    },
    {
      "ref": "Niddah 21b:25",
      "page_index": 41,
      "segment_index": 24,
      "start_char": 0,
      "end_char": 42,
      "quote": "אמר אביי בשפופרת כולי עלמא לא פליגי דטהורה",
      "sha256_utf8": "a65910b1ad0c6c152ff0fedffddc9a7aec8437aba3ef09307bdc45cae6787d83",
      "cohort": "probability_core"
    },
    {
      "ref": "Niddah 22a:1",
      "page_index": 42,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 90,
      "quote": "כי פליגי בחתיכה מר סבר דרכה של אשה לראות דם בחתיכה ומר סבר אין דרכה של אשה לראות דם בחתיכה",
      "sha256_utf8": "e410f195c979a0c70a2608943cc2036eada4948891ddecb299c35f51f81b4b27",
      "cohort": "probability_core"
    },
    {
      "ref": "Niddah 22a:2",
      "page_index": 42,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 50,
      "quote": "רבא אמר דכולי עלמא אין דרכה של אשה לראות דם בחתיכה",
      "sha256_utf8": "752e4b42a5653b993f9e33da1567556b775fae5bf7d88f0a8aff7d3e5442ac1a",
      "cohort": "probability_core"
    },
    {
      "ref": "Niddah 22a:3",
      "page_index": 42,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 127,
      "quote": "והכא באשה טהורה ומקור מקומו טמא קמיפלגי דר' אליעזר סבר אשה טהורה ודם טמא דהא אתי דרך מקור ורבנן סברי אשה טהורה ומקור מקומו טהור",
      "sha256_utf8": "3630b0678574e42f329e3e5cf07b256a33e66a2bd43307333103ff0c755f65a9",
      "cohort": "probability_core"
    },
    {
      "ref": "Niddah 22a:4",
      "page_index": 42,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 147,
      "quote": "בעא מיניה רבה מרב הונא הרואה קרי בקיסם מהו (ויקרא טו ) ממנו אמר רחמנא עד דנפיק מבשרו ולא בקיסם או דלמא האי ממנו עד שתצא טומאתו לחוץ ואפי' בקיסם נמי",
      "sha256_utf8": "bee96c778d024eb3d33cf32c476abc1aa30ac285e4a5acdca1b005b2d130d8be",
      "cohort": "probability_core"
    },
    {
      "ref": "Niddah 22a:5",
      "page_index": 42,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 56,
      "quote": "אמר ליה תיפוק ליה דהוא עצמו אינו מטמא אלא בחתימת פי האמה",
      "sha256_utf8": "9cb805fd7cf203e68b276be9e84c514835b9201a5eb4a17e136ccc0dfc0a0651",
      "cohort": "probability_core"
    },
    {
      "ref": "Niddah 22a:6",
      "page_index": 42,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 40,
      "quote": "למימרא דנוגע הוי אלא מעתה אל יסתור בזיבה",
      "sha256_utf8": "43a4c520cfacd4093315fba5afa0c121f09f5fa7c5b80b3f9ae51ec103b9e4bd",
      "cohort": "probability_core"
    },
    {
      "ref": "Niddah 22a:7",
      "page_index": 42,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 95,
      "quote": "אלמה תניא (ויקרא טו, לב) זאת תורת הזב ואשר תצא ממנו שכבת זרע מה זיבה סותרת אף שכבת זרע נמי סותר",
      "sha256_utf8": "9de25a38c0523445f47d947db32a8fc1f075f4f98203006f96a82affebd10b94",
      "cohort": "probability_core"
    },
    {
      "ref": "Niddah 22a:8",
      "page_index": 42,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 62,
      "quote": "אמר ליה סתירה היינו טעמא דסותר לפי שאי אפשר לה בלא צחצוחי זיבה",
      "sha256_utf8": "b517f2592d9bd6e5491b17fe79df519409a8a0c0f09c5d09ea88f1a4903162cc",
      "cohort": "probability_core"
    },
    {
      "ref": "Niddah 22a:9",
      "page_index": 42,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 81,
      "quote": "אלא מעתה תסתור כל שבעה אלמה תניא זאת תורת הזב וגו' מה זיבה סותרת אף שכבת זרע סותר",
      "sha256_utf8": "00fda214235bc0e4a3a591aef728cf86e7cda217fe3a44070d70605ee139e4fa",
      "cohort": "context_expansion"
    },
    {
      "ref": "Niddah 22a:10",
      "page_index": 42,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 117,
      "quote": "אי מה זיבה סותרת כל ז' אף שכבת זרע נמי סותר כל ז' ת\"ל (ויקרא טו, לב) לטמאה בה אין לך בה אלא מה שאמור בה סותרת יום אחד",
      "sha256_utf8": "3c01fb86b7928097e8d62995b92e6e8fa3887568a51676749ac06875f987c6d0",
      "cohort": "context_expansion"
    },
    {
      "ref": "Niddah 22a:11",
      "page_index": 42,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 120,
      "quote": "אמר ליה גזירת הכתוב היא זיבה גמורה דלא ערבה בה שכבת זרע סותרת כל שבעה צחצוחי זיבה דערבה בה שכבת זרע לא סותרת אלא יום אחד",
      "sha256_utf8": "e82d9d464c76b1d06f90b02dba05d54913b592035fc90814abc80cc1d5c39652",
      "cohort": "context_expansion"
    }
