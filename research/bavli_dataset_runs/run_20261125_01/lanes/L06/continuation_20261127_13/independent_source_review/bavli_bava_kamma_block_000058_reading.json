      "end_char": 39,
      "quote": "מנא ידעינן ועוד דשמואל נמי דלמא הכי הוא",
      "sha256_utf8": "87fa8a2924c6dd50bcfc16306067bb72ae1783d5c598e74c0c690c06440c6c15",
      "cohort": "context_expansion"
