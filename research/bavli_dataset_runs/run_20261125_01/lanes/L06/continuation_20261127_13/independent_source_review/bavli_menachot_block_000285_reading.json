      "segment_index": 26,
      "start_char": 0,
      "end_char": 42,
      "quote": "האי תנא סבר לה כותיה בחדא ופליג עליה בחדא:",
      "sha256_utf8": "30046c02049b06625826f1b023ff573c103dda1f13c48aeac1eda6d76a686584",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 86a:28",
