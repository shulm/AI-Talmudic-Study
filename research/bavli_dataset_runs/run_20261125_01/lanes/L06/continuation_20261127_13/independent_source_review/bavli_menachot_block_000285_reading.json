      "page_index": 170,
      "segment_index": 19,
      "start_char": 0,
      "end_char": 67,
      "quote": "<big><strong>גמ׳</strong></big> איבעיא להו מגרגרו תנן או מגלגלו תנן",
      "sha256_utf8": "56468f3e5a0faafc433bcaa884bfff3e9d373560d47f4a16b91a93f1f596ba16",
      "cohort": "context_expansion"
    },
    {
