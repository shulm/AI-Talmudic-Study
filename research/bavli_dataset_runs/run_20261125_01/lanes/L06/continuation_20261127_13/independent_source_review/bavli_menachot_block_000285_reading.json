      "sha256_utf8": "e252f24fd9f2318e640da77f00e0448efb7932a7dcb589d6d5eb7f3ac2b6984b",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 86a:29",
      "page_index": 170,
      "segment_index": 28,
      "start_char": 0,
      "end_char": 180,
      "quote": "אף כל המנחות היו בדין שיטענו שמן זית זך מה מנורה שאינה לאכילה טעונה שמן זית זך מנחות שהן לאכילה אינו דין שיטענו שמן זית זך תלמוד לאמר (שמות כז, כ) זך כתית למאור ואין זך כתית למנחות",
      "sha256_utf8": "935adc3760cc8ffb2ec1b4f3e96a1b66c5c2ce8ac0ba51ce7d27fa2e39b8dfd0",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 86b:1",
      "page_index": 171,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 113,
