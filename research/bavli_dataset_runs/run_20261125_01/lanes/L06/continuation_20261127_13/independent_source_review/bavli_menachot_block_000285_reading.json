      "page_index": 171,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 82,
      "quote": "(ויקרא כד, ג) מחוץ לפרכת העדות באהל מועד עדות הוא לכל באי עולם שהשכינה שורה בישראל",
      "sha256_utf8": "175928a8c5dff60dca5165a5572dae392e0e64768b1a9fe214668c72835b0061",
      "cohort": "context_expansion"
