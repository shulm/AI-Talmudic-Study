      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 87b:15",
      "page_index": 173,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 37,
      "quote": "ויכניס כיון דבקללה כתיב לאו אורח ארעא",
      "sha256_utf8": "84fc7efe5a533a338070bb1b0a249a60b6d8eecc40d0a69345a7e64b528a06c3",
      "cohort": "context_expansion"
    },
    {
