  "blind_to_producer_labels": true,
  "core_segments": 10,
  "context_segments": 30,
  "evidence": [
    {
      "ref": "Bava Kamma 31a:4",
      "page_index": 60,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 124,
      "quote": "<big><strong>מתני׳</strong></big> שני קדרין שהיו מהלכין זה אחר זה ונתקל הראשון ונפל ונתקל השני בראשון הראשון חייב בנזקי שני:",
      "sha256_utf8": "2196639b98b9f834a24653f0ac66bc4db7c9f882a0c17d779345820deedc4ed8",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:5",
      "page_index": 60,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 164,
      "quote": "<big><strong>גמ׳</strong></big> אמר רבי יוחנן לא תימא מתני' ר' מאיר היא דאמר נתקל פושע הוא וחייב אלא אפילו לרבנן דאמרי אנוס הוא ופטור הכא חייב שהיה לו לעמוד ולא עמד",
      "sha256_utf8": "a5b8e766c9f6eebec978550ed6e7368ae1f865e3cd527ff970953d344d04db90",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:6",
      "page_index": 60,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 70,
      "quote": "רב נחמן בר יצחק אמר אפילו תימא לא היה לו לעמוד היה לו להזהיר ולא הזהיר",
      "sha256_utf8": "96d5be7b5b29b97ebb8ece4fb4c8d0a9a1ee4c018f05088394174f67e6e873de",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:7",
      "page_index": 60,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 59,
      "quote": "ורבי יוחנן אמר כיון דלא היה לו לעמוד לא היה לו להזהיר דטריד",
      "sha256_utf8": "c6f0274e126c72dcbf4c009a9cd2680cbaa555301129a9684e577608731e1034",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:8",
      "page_index": 60,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 82,
      "quote": "תנן היה בעל קורה ראשון ובעל חבית אחרון נשברה חבית בקורה פטור ואם עמד בעל קורה חייב",
      "sha256_utf8": "cc119d5360586e1ab551782e66c3b7d126e78228a3a07ea7d77d4b52a7788a24",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:9",
      "page_index": 60,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 56,
      "quote": "מאי לאו שעמד לכתף דאורחיה הוא וקתני חייב דהוה ליה להזהיר",
      "sha256_utf8": "40462795e3a3a5a6c6ab661cfc6c0c026a4333b4f8957a9d463cef6bc4d89dd6",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:10",
      "page_index": 60,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 13,
      "quote": "לא כשעמד לפוש",
      "sha256_utf8": "8444039ab6f1c31065486bc3436fb19190bdfd5ea4a8636b3160b8bf105776a5",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:11",
      "page_index": 60,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 116,
      "quote": "אבל עמד לכתף מאי פטור אדתני סיפא ואם אמר לו לבעל חבית עמוד פטור לפלוג וליתני בדידה בד\"א כשעמד לפוש אבל עמד לכתף פטור",
      "sha256_utf8": "6b103de8f30306ea7a0705ceba76ff59e8addf32a14d21e44e21f7a5bf864565",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:12",
      "page_index": 60,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 54,
      "quote": "הא קמ\"ל דאע\"ג דעמד לפוש כי קאמר לו לבעל חבית עמוד פטור",
      "sha256_utf8": "420b3b8fe6407299ef7e1767bd298ee6f1f6f263aee9741811523ce7ae46158a",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:13",
      "page_index": 60,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 226,
      "quote": "ת\"ש הקדרין והזגגין שהיו מהלכין זה אחר זה נתקל הראשון ונפל ונתקל השני בראשון והשלישי בשני ראשון חייב בנזקי שני ושני חייב בנזקי שלישי ואם מחמת ראשון נפלו ראשון חייב בנזקי כולם ואם הזהירו זה את זה פטורין מאי לאו שלא היה להן לעמוד",
      "sha256_utf8": "370a6d9fa1cf9c33839012b5a39816aad2c58fe510162d6365bf025ba1b2bdcf",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:14",
      "page_index": 60,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 17,
      "quote": "לא שהיה להן לעמוד",
      "sha256_utf8": "46362dcce03a54bd92d805d08eaf3363f716f252449d3bfcb8f03919b190515a",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:15",
      "page_index": 60,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 150,
      "quote": "אבל לא היה להם לעמוד מאי פטור אי הכי אדתני סיפא אם הזהירו זה את זה פטור לפלוג וליתני בדידה במה דברים אמורים שהיה להן לעמוד אבל לא היה להן לעמוד פטורין",
      "sha256_utf8": "9f8c92a0f5a864e2fe21f06d36742296310676c30d895e0166927fc4f8115595",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:16",
      "page_index": 60,
      "segment_index": 15,
      "start_char": 0,
      "end_char": 54,
      "quote": "הא קמ\"ל דאע\"ג דהיה להן לעמוד כי הזהירו זה את זה פטורין",
      "sha256_utf8": "f1c3158cedd72ab6554144141651efb0f8be04a2b7dc1dc62a58fe396c99b5bd",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:17",
      "page_index": 60,
      "segment_index": 16,
      "start_char": 0,
      "end_char": 110,
      "quote": "אמר רבא ראשון חייב בנזקי שני בין בנזקי גופו בין בנזקי ממונו שני חייב בנזקי שלישי בנזקי גופו אבל לא בנזקי ממונו",
      "sha256_utf8": "11c68056e4bb37ef211fe2cdc8ab787f731d85aaf221a853d30e68feb0d98e91",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31a:18",
      "page_index": 60,
      "segment_index": 17,
      "start_char": 0,
      "end_char": 83,
      "quote": "ממה נפשך אי נתקל פושע הוא שני נמי ליחייב אי נתקל לאו פושע הוא אפילו ראשון נמי ליפטר",
      "sha256_utf8": "087dff926e9a0868fe0925dd2b30b22cc6753687f2e154b3f8db0d482c636e10",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31b:1",
      "page_index": 61,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 98,
      "quote": "ראשון ודאי פושע הוא שני אגופו מחייב דהוה לו לעמוד ולא עמד אממונו פטור דא\"ל האי בירא לאו אנא כריתיה",
      "sha256_utf8": "9cce9bbabc1966d6be0b7e9a34cb632c070d8aa166973b82e58f0568b94b069d",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31b:2",
      "page_index": 61,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 72,
      "quote": "מיתיבי כולן חייבין על נזקי גופן ופטורין על נזקי ממונן מאי לאו אפי' ראשון",
      "sha256_utf8": "9f52cb02a2e9086f8d003ae63b215cb43f51d194b0a739b0b7708cddab5220ca",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31b:3",
      "page_index": 61,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 59,
      "quote": "לא לבר מראשון והא כולם קתני אמר רב אדא בר אהבה כולן הניזקין",
      "sha256_utf8": "7b2bbda25f8d3896a95ef89a2e16122730ad917976693783dbb9269470318f8f",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31b:4",
      "page_index": 61,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 96,
      "quote": "האי מאי אי אמרת בשלמא אפילו ראשון היינו דקתני כולן אלא אי אמרת לבר מראשון מאי כולן ליתני הניזקין",
      "sha256_utf8": "053d86f6043323bade2da0b3ba4cb440f5ea6179fae8628cb53eef49ce3eb5ed",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31b:5",
      "page_index": 61,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 164,
      "quote": "אלא אמר רבא ראשון חייב בין בנזקי גופו דשני בין בנזקי ממונו דשני ושני חייב בנזקי שלישי בנזקי גופו אבל לא בנזקי ממונו מ\"ט דהוה ליה בור ולא מצינו בור שחייב בו את הכלים",
      "sha256_utf8": "af8c7300b85a33cbf87f1609500b924f96166433185ad5d85c7e9e6a85dff384",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31b:6",
      "page_index": 61,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 84,
      "quote": "הניחא לשמואל דאמר כל תקלה בור הוא אלא לרב דאמר אי אפקריה אין אי לא לא מאי איכא למימר",
      "sha256_utf8": "e06a18de92ffb338484cae31ac027b4a1ff3f413c94b0de008ffc6765cbffa33",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 31b:7",
      "page_index": 61,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 93,
      "quote": "לעולם כדאמר מעיקרא ודקשיא לך כולן חייבין תרגמה רב אדא בר מניומי קמיה דרבינא שהוזקו כלים בכלים",
      "sha256_utf8": "dd2bbfef2c21d107bf6444020c8a3c7e638ef039368460da3443e3f7e1bcdf0c",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 31b:8",
      "page_index": 61,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 127,
      "quote": "אמר מר אם מחמת ראשון נפלו ראשון חייב בנזקי כולם מחמת ראשון היכי נפיל רב פפא אמר דפסקה לאורחיה כשלדא רב זביד אמר כחוטרא דסמיותא:",
      "sha256_utf8": "1bac8c5b56584ede3002d841d9c769471285ce78d3f8fd5b851332e2962c7bfc",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 31b:9",
      "page_index": 61,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 124,
      "quote": "<big><strong>מתני׳</strong></big> זה בא בחביתו וזה בא בקורתו נשברה כדו של זה בקורתו של זה פטור שלזה רשות להלך ולזה רשות להלך",
      "sha256_utf8": "27052acfc68f4ac417ad1c2bf4b2036e4dc57e6666c533a56592c58bd138b099",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 31b:10",
      "page_index": 61,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 67,
      "quote": "היה בעל הקורה ראשון ובעל חבית אחרון נשברה חבית בקורה פטור בעל הקורה",
      "sha256_utf8": "1ce51af9efde7cb0acd78cd49d46eb3f3274a807083b40733dc06136047ee103",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 32a:1",
      "page_index": 62,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 50,
      "quote": "ואם עמד בעל קורה חייב ואם אמר לבעל חבית עמוד  פטור",
      "sha256_utf8": "cdade517f81a7879e7954673f46d5176657dd877a81bb0dab1d88772b95d2de4",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 32a:2",
      "page_index": 62,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 133,
      "quote": "היה בעל חבית ראשון ובעל קורה אחרון נשברה חבית בקורה חייב ואם עמד בעל חבית פטור ואם אמר לבעל קורה עמוד חייב וכן זה בא בנרו וזה בפשתנו:",
      "sha256_utf8": "11b87d96ac265e962e352a15bd0dfb54bc3a0338b067a19d7e5bfaa7ba59d11c",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 32a:3",
      "page_index": 62,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 139,
      "quote": "<big><strong>גמ׳</strong></big> בעא מיניה רבה בר נתן מרב הונא המזיק את אשתו בתשמיש המטה מהו כיון דברשות קעביד פטור או דלמא איבעי ליה לעיוני",
      "sha256_utf8": "9b0328e38cf183067b9c52fd80588d539102d1a094ca4fd32796eed82ad1d300",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 32a:4",
      "page_index": 62,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 40,
      "quote": "א\"ל תניתוה שלזה רשות להלך ולזה רשות להלך",
      "sha256_utf8": "42350dcad1e10b782fbc57b1dc64caaa031159f951e3793e6c04792ba9da58d5",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 32a:5",
      "page_index": 62,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 115,
      "quote": "אמר רבא ק\"ו ומה יער שזה לרשותו נכנס וזה לרשותו נכנס נעשה כמי שנכנס לרשות חבירו וחייב זה שלרשות חבירו נכנס לא כל שכן",
      "sha256_utf8": "974d59860d28ef6d686c3847a19132b322c10d2230c23fc0e99c7a9fd025ef07",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 32a:6",
      "page_index": 62,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 41,
      "quote": "אלא הא קתני שלזה רשות להלך ולזה רשות להלך",
      "sha256_utf8": "6aa59c1a77547667bcf4125a69e5047b0da509e433326e9cae72b711567d896a",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 32a:7",
      "page_index": 62,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 43,
      "quote": "התם תרוייהו כהדדי נינהו הכא איהו קעביד מעשה",
      "sha256_utf8": "391bab54e5ad4d3dca3296c01387c19f047ea594ba3e0def28098e451c3b6e1a",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 32a:8",
      "page_index": 62,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 59,
      "quote": "והיא לא והכתיב (ויקרא יח, כט) ונכרתו הנפשות העושות מקרב עמם",
      "sha256_utf8": "f9852076a63cc1336694f15e776b418111ffab10ae22f5740c1da3fbfb66daf0",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 32a:9",
      "page_index": 62,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 43,
      "quote": "הנאה לתרוייהו אית להו איהו מעשה הוא דקעביד:",
      "sha256_utf8": "6c94c7d8165eb672efe61d99742f6609f1f4c80c6e5cd694357560f65eb99a18",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 32a:10",
      "page_index": 62,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 115,
      "quote": "היה בעל קורה ראשון כו': אמר ריש לקיש שתי פרות ברה\"ר אחת רבוצה ואחת מהלכת בעטה מהלכת ברבוצה פטורה רבוצה במהלכת חייבת",
      "sha256_utf8": "264fdda2344d74789a30ffb6ba1477d122b7128abe7df6256535351a13a95a1c",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 32a:11",
      "page_index": 62,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 131,
      "quote": "לימא מסייע ליה היה בעל קורה ראשון ובעל חבית אחרון נשברה חבית בקורה פטור ואם עמד בעל קורה חייב והא הכא דכרבוצה במהלכת דמי וקתני חייב",
      "sha256_utf8": "89572d4c38ef63e2bae2c2af60d4e8343d94c8410d18b29a6811952614471380",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 32a:12",
      "page_index": 62,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 118,
      "quote": "ותסברא הא סייעי בעיא לא מסתייא דלא מסייעי אלא מקשה נמי קשיא טעמא דבעטה הא הוזקה ממילא פטור והא מתני' דממילא וקתני חייב",
