  "plan_sha256": "1a0d2eeeffef1e9330145795c38be7e90ef4e9655818a0076e298ac7b6701f94",
  "block_id": "block_000126",
  "roles": [
    "probability_sample"
  ],
  "blind_to_producer_labels": true,
  "core_segments": 10,
  "context_segments": 27,
  "evidence": [
    {
      "ref": "Bava Kamma 34a:13",
      "page_index": 66,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 151,
      "quote": "<big><strong>מתני׳</strong></big> שור שוה מאתים שנגח שור שוה מאתים ואין הנבילה יפה כלום אמר ר\"מ על זה נאמר (שמות כא, לה) ומכרו את השור החי וחצו את כספו",
      "sha256_utf8": "0fb75508305399f7cf5c4f2125430f4055d37424c2f29326cf8e07f61ee58d2a",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34a:14",
      "page_index": 66,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 200,
      "quote": "א\"ל רבי יהודה וכן הלכה קיימת ומכרו את השור החי וחצו את כספו ולא קיימת וגם המת יחצון ואיזה זה שור שוה מאתים שנגח שור שוה מאתים והנבילה יפה חמשים זוז שזה נוטל חצי החי וחצי המת וזה נוטל חצי החי וחצי המת:",
      "sha256_utf8": "b023c31b1277a7633be0c603854622deba5b37bf7c48c47fdb31ac593f1ffe50",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34a:15",
      "page_index": 66,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 177,
      "quote": "<big><strong>גמ׳</strong></big> ת\"ר שור שוה מאתים שנגח שור שוה מאתים והנבילה יפה חמשים זוז זה נוטל חצי החי וחצי המת וזה נוטל חצי החי וחצי המת וזהו שור האמור בתורה דברי רבי יהודה",
      "sha256_utf8": "fc1caa0af33f3b8dfcfebbff20658f77787cbf048e966d3dfb411125aed360f8",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34a:16",
      "page_index": 66,
      "segment_index": 15,
      "start_char": 0,
      "end_char": 197,
      "quote": "רבי מאיר אומר אין זהו שור האמור בתורה אלא שור שוה מאתים שנגח לשור שוה מאתים ואין הנבילה יפה כלום על זה נאמר ומכרו את השור החי וחצו את כספו אלא מה אני מקיים וגם את המת יחצון פחת שפחתו מיתה מחצין בחי",
      "sha256_utf8": "8adb2d1d6d09b0a8fff048e98e0e1858fc081ba7c4373df9d07a2450f3972321",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34a:17",
      "page_index": 66,
      "segment_index": 16,
      "start_char": 0,
      "end_char": 91,
      "quote": "מכדי בין ר\"מ בין רבי יהודה האי מאה ועשרים וחמשה שקיל והאי מאה ועשרים וחמשה שקיל מאי בינייהו",
      "sha256_utf8": "fe112132881895c2eda57bd2af2c8963c393330198cc577d33820cb36298c072",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34a:18",
      "page_index": 66,
      "segment_index": 17,
      "start_char": 0,
      "end_char": 103,
      "quote": "אמר רבא פחת נבילה איכא בינייהו רבי מאיר סבר פחת נבילה דניזק הוי ורבי יהודה סבר פחת נבילה דמזיק הוי פלגא",
      "sha256_utf8": "870a262a6cbd70591c1d0f9bdee42fd5dfe8bd967e4c25c64319bf1abb195633",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34a:19",
      "page_index": 66,
      "segment_index": 18,
      "start_char": 0,
      "end_char": 31,
      "quote": "א\"ל אביי אם כן מצינו לרבי יהודה",
      "sha256_utf8": "0cbc27d6dab57567a80ad4aa43676593eda2cd3e64ed90c75ced3a839607f3d4",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34b:1",
      "page_index": 67,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 13,
      "quote": "תם חמור ממועד",
      "sha256_utf8": "1f3fa19d250cccec05eca5c7d0f10a2bcc23ef229f9ed39d128206cf932042aa",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34b:2",
      "page_index": 67,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 131,
      "quote": "וכי תימא הכי נמי כדתנן ר' יהודה אומר תם חייב ומועד פטור אימר דשמעת ליה לרבי יהודה לענין שמירה דכתיבי קראי לענין תשלומין מי שמעת ליה",
      "sha256_utf8": "26a45cd7dca620166a979475f3e016f339f330096099ad6aa164d8769dae9214",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34b:3",
      "page_index": 67,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 128,
      "quote": "והתניא רבי יהודה אומר יכול שור שוה מנה שנגח שור שוה חמש סלעים והנבילה יפה סלע זה נוטל חצי החי וחצי המת וזה נוטל חצי החי וחצי המת",
      "sha256_utf8": "003e56feba495a9592b2568571415c12d196ea52e52e43a5ef4be4d37f19eac6",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34b:4",
      "page_index": 67,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 114,
      "quote": "אמרת וכי מועד למה יוצא להחמיר עליו או להקל עליו הוי אומר להחמיר עליו ומה מועד אינו משלם אלא מה שהזיק תם הקל לא כ\"ש",
      "sha256_utf8": "5b3dde8cb00270eb17e692f8504defdea590b65b90f15d2b6b11474cfed17800",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34b:5",
      "page_index": 67,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 61,
      "quote": "אלא א\"ר יוחנן שבח נבילה איכא בינייהו דמ\"ס דניזק הוי ומ\"ס פלגא",
      "sha256_utf8": "5536f28c3e050f6b6b2ad44077f819d29cea113039b5fc56c50b92d18540d16a",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 34b:6",
      "page_index": 67,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 182,
      "quote": "והיינו דקא קשיא ליה לר\"י השתא דאמרת חס רחמנא עילויה דמזיק דשקיל בשבחא יכול שור שוה חמש סלעים שנגח שור שוה מנה והנבילה יפה חמשים זוז זה נוטל חצי החי וחצי המת וזה נוטל חצי החי וחצי המת",
      "sha256_utf8": "1b60b0b80e4230a08592e83d5e523eaf3bc5c362a46da9cad8782317cbdf0fd1",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 34b:7",
      "page_index": 67,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 94,
      "quote": "אמרת היכן מצינו מזיק נשכר שזה נשכר ואומר (שמות כא, לו) שלם ישלם בעלים משלמין ואין בעלים נוטלין",
      "sha256_utf8": "32ffab31ae1848e9fe1a4c2faa06bb0dbf91e19ebc9e9e6471b626cf964ad92e",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 34b:8",
      "page_index": 67,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 165,
      "quote": "מאי ואומר וכי תימא הני מילי היכא דאיכא פסידא לניזק אבל היכא דליכא פסידא לניזק כגון שור שוה חמש סלעים שנגח שור שוה חמש סלעים והנבילה יפה שלשים זוז שקיל נמי מזיק בשבחא",
      "sha256_utf8": "d0c752c1efdb426685faa7456601abbf080d5f627bd8ba67bceb31492904512c",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 34b:9",
      "page_index": 67,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 45,
      "quote": "ואומר שלם ישלם בעלים משלמין ואין בעלים נוטלין",
      "sha256_utf8": "82ddcc164f5efc1b1b48232c39c59f434e2e138f6d4a49ce4e6a472fb2c6a6ec",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 34b:10",
      "page_index": 67,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 125,
      "quote": "א\"ל רב אחא בר תחליפא לרבא א\"כ מצינו לרבי יהודה תם משלם יותר מחצי נזק והתורה אמרה (שמות כא, לה) ומכרו את השור החי וחצו את כספו",
      "sha256_utf8": "31e66f8cc9cfcdf4197b4bd46fe7071d013dce2b3f774b7d82b56d3ef81a8810",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 34b:11",
      "page_index": 67,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 37,
      "quote": "אית ליה לר\"י פחת שפחתה מיתה מחצין בחי",
      "sha256_utf8": "b66cb844f770e7a75895aff5c403abfb548b1321f4dabfb9077e0c8f8d5ecac9",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 34b:12",
      "page_index": 67,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 110,
      "quote": "מנא ליה (שמות כא, לה) מוגם את המת יחצון והא אפקיה ר' יהודה לזה נוטל חצי החי וחצי המת וזה נוטל חצי החי וחצי המת",
      "sha256_utf8": "70a55ac0d99ed62f90693e5227f9836ee8e68f29cb10357f572cd6584ba9765b",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 34b:13",
      "page_index": 67,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 39,
      "quote": "א\"כ נכתוב קרא ואת המת מאי וגם ש\"מ תרתי:",
      "sha256_utf8": "1f079eb2c26805ceaff1ed69ac92fab3089fd0f62c9bd0f83f7bbdd080d8bdef",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 34b:14",
      "page_index": 67,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 110,
      "quote": "<big><strong>מתני׳</strong></big> יש חייב על מעשה שורו ופטור על מעשה עצמו פטור על מעשה שורו וחייב על מעשה עצמו",
      "sha256_utf8": "85f079227cdf4007d7f6e425d057a2627f885927903848b156364e24c7a4fb37",
      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 34b:15",
      "page_index": 67,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 120,
      "quote": "כיצד שורו שבייש פטור והוא שבייש חייב שורו שסימא את עין עבדו והפיל את שינו פטור והוא שסימא את עין עבדו והפיל את שינו חייב",
      "sha256_utf8": "0c6fb60bf09c2e4355f950c5182f29b1fe5c6744e5f1215f8e1a8b894c0ce70f",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34b:16",
      "page_index": 67,
      "segment_index": 15,
      "start_char": 0,
      "end_char": 138,
      "quote": "שורו שחבל באביו ובאמו חייב והוא שחבל באביו ואמו פטור שורו שהדליק את הגדיש בשבת חייב והוא שהדליק את הגדיש בשבת פטור מפני שהוא מתחייב בנפשו:",
      "sha256_utf8": "b6b1dae4288ace2cc013bf39de77035a359ffc5e29d14cf744ad12e50a22281d",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34b:17",
      "page_index": 67,
      "segment_index": 16,
      "start_char": 0,
      "end_char": 190,
      "quote": "<big><strong>גמ׳</strong></big> תני רבי אבהו קמיה דרבי יוחנן כל המקלקלין פטורין חוץ מחובל ומבעיר א\"ל פוק תני לברא חובל ומבעיר אינה משנה ואם תימצי לומר משנה חובל בצריך לכלבו מבעיר בצריך לאפרו",
      "sha256_utf8": "915401a90beaf38e5d3d35dadd6b09e1e80617a5bd2eef5a83b33bef7575fd2b",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 34b:18",
      "page_index": 67,
      "segment_index": 17,
      "start_char": 0,
      "end_char": 108,
      "quote": "תנן שורו שהדליק את הגדיש בשבת חייב והוא שהדליק את הגדיש בשבת פטור וקתני הוא דומיא דשורו מה שורו דלא קבעי ליה",
      "sha256_utf8": "8b1b4c3d4bd2687dccd73be412bff92618842f7c46ec9091e8fb06b0a7803d56",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 35a:1",
      "page_index": 68,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 55,
      "quote": "אף הוא נמי דלא קבעי ליה וקתני פטור מפני שהוא נדון בנפשו",
      "sha256_utf8": "4fa20658c4118b96395ff575e4f6142b3fbb47073ef4f5121f0f67158c03f76a",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 35a:2",
      "page_index": 68,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 54,
      "quote": "לא שורו דומיא דידיה מה הוא דקבעי ליה אף שורו דקבעי ליה",
      "sha256_utf8": "c4edae33fe65975ab9cf3c8681d7be642fbd8f8348d5d78766d10025dc8e0b2d",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 35a:3",
      "page_index": 68,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 106,
      "quote": "שורו היכי משכחת לה א\"ל רב אויא הכא במאי עסקינן בשור פקח שעלתה לו נשיכה בגבו וקא בעי למקלייה ואיגנדר בקוטמא",
      "sha256_utf8": "4ffa7344d99835cdc0e7cf119ff431cde9e16706ecd46b768f6e7d703b630ac0",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 35a:4",
      "page_index": 68,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 38,
      "quote": "ומנא ידעינן דלבתר דקלייה קמגנדר בקוטמא",
      "sha256_utf8": "25742d2dce3341d2217f2c353296c4c3f4c5b931b9b93b8d5c147123815555fb",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 35a:5",
      "page_index": 68,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 111,
      "quote": "ומי איכא כי האי גוונא אין דההוא תורא דהוה בי רב פפא דהוה כיבין ליה חינכיה עייל ופתקיה לנזייתא ושתי שיכרא ואיתסי",
      "sha256_utf8": "38dae4c95edc9b99384b9331ebed3bd107852921c1276c3afa66457c21d23220",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 35a:6",
      "page_index": 68,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 137,
      "quote": "אמרו רבנן קמיה דרב פפא מי מצית אמרת שורו דומיא דידיה והא קתני שורו שבייש פטור והוא שבייש חייב שורו דומיא דידיה נתכוון לבייש היכי משכחת לה",
      "sha256_utf8": "be108be7f530684274b35ddee199fd49b7f4b533fa32aaad957462f48d33bb0a",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 35a:7",
      "page_index": 68,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 61,
      "quote": "כגון שנתכוון להזיק דאמר מר נתכוון להזיק אע\"פ שלא נתכוון לבייש",
      "sha256_utf8": "93f82427c8c9f8d72e70d5796255b73e09daca2c03193703e396a4d4704a07d0",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 35a:8",
      "page_index": 68,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 21,
      "quote": "רבא אמר מתניתין בשוגג",
      "sha256_utf8": "64f35edcd01fe8450754552a5c86e527a3735e8d435426cb6407e37075e92f24",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 35a:9",
      "page_index": 68,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 64,
      "quote": "וכדתנא דבי חזקיה דתנא דבי חזקיה (ויקרא כד, כא) מכה אדם ומכה בהמה",
      "sha256_utf8": "517b5689c26f6662521ce7b24c7479c00f0b4bc2b492ea533d434317ea4fe221",
      "cohort": "context_expansion"
    },
    {
      "ref": "Bava Kamma 35a:10",
      "page_index": 68,
      "segment_index": 9,
