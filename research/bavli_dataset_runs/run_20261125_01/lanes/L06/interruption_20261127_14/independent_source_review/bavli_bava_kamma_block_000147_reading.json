      "segment_index": 26,
      "start_char": 0,
      "end_char": 46,
      "quote": "משום דא\"ל סוף סוף את לאו תורא בעית שלומי לדידי",
      "sha256_utf8": "888beb8ad5fb0d9198e6f3ee720601da9cc840ab0349d972f3747dd12d08dad9",
      "cohort": "probability_core"
    },
