      "cohort": "probability_core"
    },
    {
      "ref": "Bava Kamma 40a:26",
      "page_index": 78,
      "segment_index": 25,
      "start_char": 0,
      "end_char": 31,
      "quote": "ונימא ליה אי תם הוה משתלם מגופו",
