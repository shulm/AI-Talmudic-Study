      "page_index": 84,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 36,
      "quote": "אמרי הני מילי לבני מערבא אליבא דרבנן",
      "sha256_utf8": "5579cbab75f752d9f35982c388a7decc6e1a902e21043116a887531682a60267",
