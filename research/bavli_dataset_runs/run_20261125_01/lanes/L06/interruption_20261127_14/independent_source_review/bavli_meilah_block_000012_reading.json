  "evidence": [
    {
      "ref": "Meilah 5a:1",
      "page_index": 8,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 96,
      "quote": "או היתר זריקה שנינו או היתר אכילה שנינו חזקיה אמר היתר שחיטה שנינו ר' יוחנן אמר היתר אכילה שנינו",
      "sha256_utf8": "c3cb477a4907280692f8d6cf88ddfced8c9c125b0776787aab43c11ea7184eb5",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:2",
      "page_index": 8,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 51,
      "quote": "א\"ר זירא  לא דייקא מתני' דלא כחזקיה ודלא כרבי יוחנן",
      "sha256_utf8": "c6eac0bf5bbce2a29ff25af05ca515f77e3eb5d5053a6e9cc68bf2545114e767",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:3",
      "page_index": 8,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 54,
      "quote": "תנן שלנה ושנטמאת ושיצאת לאו דלן דם וקתני אין מועלין בו",
      "sha256_utf8": "b227c10e5317a539cda1f701846bf5a5e1c5cc05fad0b490cb18d34ab3e28c7b",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:4",
      "page_index": 8,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 22,
      "quote": "וש\"מ  היתר זריקה שנינו",
      "sha256_utf8": "87743454319bc101276688799f640fc62d5085e97d3462e178a025e807c9b4b8",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:5",
      "page_index": 8,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 50,
      "quote": "לא דלן בשר אבל דם איזדריק מש\"ה קתני אין מועלין בו ",
      "sha256_utf8": "f06831458c836a505316c900b3da0e3533421e6e2cdc6c2ba24d5955b8e6c992",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:6",
      "page_index": 8,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 98,
      "quote": "תנן ואיזו היא שלא היתה לה שעת הכושר לכהנים שנשחטה חוץ לזמנה וחוץ למקומה ושקבלו פסולין וזרקו את דמה",
      "sha256_utf8": "22cf20b0181147da96f041a060f59e7c7f08fa6db0df2e538f1cd74715623db5",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:7",
      "page_index": 8,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 60,
      "quote": "ה\"ד  אילימא דזרקוהו פסולין וקבלוהו פסולין ל\"ל עד דאיכא תרתי ",
      "sha256_utf8": "36ed1afea147a2fed545fdf88b8fba107481a9d0029ae8769cba1a9d873ef47d",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:8",
      "page_index": 8,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 52,
      "quote": "אלא לאו דקבלוהו פסולין וזרקוהו כשרים וקתני מועלין בו",
      "sha256_utf8": "281fa21a40070f173270b67641b17d6788b2b132b0353bf25e2b06a1cfb73bca",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:9",
      "page_index": 8,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 21,
      "quote": "ש\"מ  היתר זריקה שנינו",
      "sha256_utf8": "3bc7fba2ab537a66f4a95926aed37a9a2a7460bbac4a1c4973774929c9a7c5c0",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:10",
      "page_index": 8,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 52,
      "quote": "מתקיף לה רב יוסף ואי ס\"ד איכא לפלוגי הכי הא דתנן התם",
      "sha256_utf8": "743d7c8a9512773c134e69f334dd2fc7a245ea8298b92b4db4aa452449c74534",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:11",
      "page_index": 8,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 94,
      "quote": "חטאת פסולה אין דמה טעון כיבוס בין שהיתה לה שעת הכושר ונפסלה ובין שלא היתה לה שעת הכושר ונפסלה ",
      "sha256_utf8": "d977d5df378ba79639eba5c6408e105c4b19d67def66fe71002b1a881620bab5",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:12",
      "page_index": 8,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 57,
      "quote": "אי זו היא שהיתה לה שעת הכושר ונפסלה שלנה ושנטמאת או שיצאה",
      "sha256_utf8": "f4fa87229fee9f38ac93f76ccceb42f21285736abc85ee16873901087e26813d",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:13",
      "page_index": 8,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 83,
      "quote": "איזוהי שלא היתה לה שעת הכושר שנשחטה חוץ למקומה חוץ לזמנה ושקבלו פסולין וזרקו את דמה",
      "sha256_utf8": "fd71bc4d75f591a23d14009cdb315b5eed7651cb78952f81ac3174fbe88f2d96",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:14",
      "page_index": 8,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 104,
      "quote": "היכי דמי אילימא דקבלוהו פסולין וזרקו פסולין הוא דאין דמה טעון כיבוס הא קבלוהו וזרקו כשרים דמה טעון כיבוס",
      "sha256_utf8": "45f9eb6a5a2f966de20bfd47b0944b5154f42fb7977f663f31a0469a01b0c094",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5a:15",
      "page_index": 8,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 61,
      "quote": "קרי כאן (ויקרא ו, כ) אשר יזה מדמה ולא שכבר הוזה  אלא לאו דוקא",
      "sha256_utf8": "db509cd20bd1288f843b0a714450f133bfd30bad700bd91e673cc5c097828454",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:1",
      "page_index": 9,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 49,
      "quote": "ה\"נ לאו דוקא  אמר רב אסי אם כן למה לי למיתני תרתי",
      "sha256_utf8": "67c244a2ecff4c7ef9dde651f308418d02b729d87211110e91c9e510d3313602",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:2",
      "page_index": 9,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 21,
      "quote": "אלא לעולם דמעילה דוקא",
      "sha256_utf8": "8355fab413b2fa67bedfb852d25739853eaa80d469b7d6a8c27a197baa2f1111",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:3",
      "page_index": 9,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 27,
      "quote": "והא קמ\"ל  דפסול עושה שיריים",
      "sha256_utf8": "2f29f88e5972c8cefac4565a5b9942e2ab039c5ba425558c641dcd4777211b6c",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:4",
      "page_index": 9,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 72,
      "quote": "אע\"ג דקיבל פסול וזרק וקיבל כשר וזרק לאו כלום היא מאי טעמא  דשיריים נינהו",
      "sha256_utf8": "ad5b46350152fbec78a4676e3d439d32d8814f54c4bcf848c8b5905a4037d96b",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:5",
      "page_index": 9,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 50,
      "quote": "והא בעא מיניה ר\"ל מר' יוחנן  פסול מהו שיעשה שיריים",
      "sha256_utf8": "9fd25893db94fdebd57bb3d07d2431d9901191e07e38285820a4fa5aa6ee2c25",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:6",
      "page_index": 9,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 76,
      "quote": "וא\"ל  אין לך דבר שיעשה שיריים אלא חוץ לזמנו וחוץ למקומו הואיל ומרצין לפיגולן",
      "sha256_utf8": "eb7af9a142ee0a7e090ca06b4b731ca6c0960152de640b919a401e7d22d73f9e",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:7",
      "page_index": 9,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 30,
      "quote": "מאי לאו בר מפסול לא אפילו פסול",
      "sha256_utf8": "349f5fbad4b9f33365fb71fbdd263c0dcedf71aa0f868510e6cf3d7fdf23fc62",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:8",
      "page_index": 9,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 15,
      "quote": "והא אין לך קתני",
      "sha256_utf8": "ff19d808761bcf9e737de150526a4288fb01c4dc9d15b35f642588f93af62ee5",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:9",
      "page_index": 9,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 106,
      "quote": "ה\"ק  אין לך דבר שאינו מרצה בציבור ועושה שיריים אלא חוץ לזמנו וחוץ למקומו אבל טמא דאיתיה בציבור משוי שיריים",
      "sha256_utf8": "e8f4015ea7ff204b4ba897ea304eeef5322a1e0d4de4546180966c9434923afc",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:10",
      "page_index": 9,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 44,
      "quote": "שאר פסולין דלא איתנון בציבור לא משוין שיריים",
      "sha256_utf8": "ec5976b76be73d5befb2fdcf77b451f2195cc73f2162be0190eb4787e89c6643",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:11",
      "page_index": 9,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 27,
      "quote": "ת\"ש  הפיגול לעולם מועלין בו",
      "sha256_utf8": "091a7e00e353da4e1b7460ca05c7c0cc32466d89f163d9dcbb99fb78dbf31280",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:12",
      "page_index": 9,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 38,
      "quote": "לאו דלא זרק ושמע מינה היתר זריקה שנינו",
      "sha256_utf8": "feeafc179f4a4e94e833c7aa1361bbc76177962b7de5875c1d1f5a57648404bc",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:13",
      "page_index": 9,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 7,
      "quote": "לא זרקה",
      "sha256_utf8": "dba0249c7af837455b07e12252b97db9303c6bd8b76b05d324d8558c10f5db21",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 5b:14",
      "page_index": 9,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 110,
      "quote": "ומאי לעולם הא קא משמע לן כדרב גידל דאמר רב גידל אמר רב זריקת פיגול אינו מוציא מידי מעילה ואינו מביא לידי מעילה",
      "sha256_utf8": "7ad1f50ce570b1d972168fdbfcbe44112635ee19d120986b12081d15b6db3bf2",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:1",
      "page_index": 10,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 64,
      "quote": "תא שמע רבי שמעון אומר יש נותר שמועלין בו ויש נותר שאין מועלין בו",
      "sha256_utf8": "f5b656bafea441f2612eceeaf34589f608105c4c64d6fc07a18b854ed693fe41",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:2",
      "page_index": 10,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 47,
      "quote": "כיצד לן לפני זריקה מועלין לאחר זריקה אין מועלין",
      "sha256_utf8": "7359cf96875cae5e583ff26baab105b3d9b6255bceb77009671789bf0671f200",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:3",
      "page_index": 10,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 55,
      "quote": "קתני מיהת מועלין בו לאו דהוה שהות למיזרקיה דאי בעי זריק",
      "sha256_utf8": "6178038b847f24b3de3e365cce6fdd3e181d33555f2302bf7eb450ad4e35163c",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:4",
      "page_index": 10,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 26,
      "quote": "ושמע מינה היתר אכילה שנינו",
      "sha256_utf8": "b6c7ac845b99ea611c4174e73c6079e633ff6847855e6fc9ab622c7c1a8eddca",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:5",
      "page_index": 10,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 45,
      "quote": "לא דקבליה סמוך לשקיעת החמה דלא היה שהות למזרק",
      "sha256_utf8": "4f5a7f4e8065a183e318e1d61a9fb07cc7a12f69103ffedb19672c5515811b72",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:6",
      "page_index": 10,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 36,
      "quote": "אבל היה שהות מאי הכי נמי דאין מועלין",
      "sha256_utf8": "89141630b795c46017b748004d1ea4d5966b346371831d7d3fb35f1bb0e1229f",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:7",
      "page_index": 10,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 54,
      "quote": "מאי איריא דתני לפני זריקה ליתני קודם שקיעה ולאחר שקיעה",
      "sha256_utf8": "82c609ab951b56455b1d291393c5851a131eb70ed41ab1cb32f507aff54aeeb6",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:8",
      "page_index": 10,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 49,
      "quote": "הכי נמי קתני קודם שיראה לזריקה ולאחר שיראה לזריקה",
      "sha256_utf8": "21939755b315feed200e0fa97b84b53c3bef456c4aee0b70f3f7eb4d6379679e",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:9",
      "page_index": 10,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 61,
      "quote": "תא שמע ר\"ש אומר  יש פיגול שמועלין בו ויש פיגול שאין מועלין בו",
      "sha256_utf8": "cac61dbd3756de05a3f92d7aecb5f8ab35e6a2eee0c55310e784c3f194723eb7",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:10",
      "page_index": 10,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 44,
      "quote": "כיצד לפני זריקה מועלין לאחר זריקה אין מועלין",
      "sha256_utf8": "e5df0d4f20e57f0963ecf52a22b68f824a4db76124c26ccf03c9136ed692af7f",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:11",
      "page_index": 10,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 105,
      "quote": "קתני מיהת לפני זריקה מועלין בו לאו דהוה שהות למיזרקיה דאי בעי זריק וקתני מועלין בו וש\"מ היתר אכילה שנינו ",
      "sha256_utf8": "f04783ef50336b705cfa378f956b1fc05ad4bbcabf18064ebf4a0c2f60d1ab24",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:12",
      "page_index": 10,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 72,
      "quote": "לא דלא הוה שהות למיזרקיה אבל הוה שהות למיזרקיה [מאי] ה\"נ דנפק מידי מעילה",
      "sha256_utf8": "bcf858497e52c6b5414bad475c8c36281435dcb237df6ec3dc4000b60dfecf77",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:13",
      "page_index": 10,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 60,
      "quote": "מאי איריא דתני לאחר זריקה  ליתני קודם שקיעה ולאחר שקיעת החמה",
      "sha256_utf8": "9ea7854f1daec9cc10515491111858427ca105fb576a684849dfce656ff3df90",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:14",
      "page_index": 10,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 45,
      "quote": "ה\"נ קאמר  קודם שיראה לזריקה לאחר שיראה לזריקה",
      "sha256_utf8": "cc4b24a1e511927723770fe764e3c523b31cc3d935161388449f3abcaa475891",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:15",
      "page_index": 10,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 81,
      "quote": "ת\"ש  הפיגול בקדשי קדשים מועלין מאי לאו דזרק ושמע מינה היתר אכילה שנינו לא דלא זרק",
      "sha256_utf8": "2cc4a876e9a27fd8d2b5336a3f9cbef45f67ab6ca6a35a328978c17621d7e264",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:16",
      "page_index": 10,
      "segment_index": 15,
      "start_char": 0,
      "end_char": 75,
      "quote": "אבל זרק מאי הכי נמי דאין מועלין בו מאי איריא דתני בקדשים קלים אין מועלין בו",
      "sha256_utf8": "73b70e1baec5ad00e0ff781a18baae7de1f48307321f9364253311fd5404053a",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:17",
      "page_index": 10,
      "segment_index": 16,
      "start_char": 0,
      "end_char": 35,
      "quote": "ליתני כאן לפני זריקה כאן לאחר זריקה",
      "sha256_utf8": "55efd8ce38f67adfd9b3a2e60c8d8238edd7f92fefbca002bd4447ec5ee16d81",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:18",
      "page_index": 10,
      "segment_index": 17,
      "start_char": 0,
      "end_char": 69,
      "quote": "הא אתיא לאשמועינן כל לאיתויי לידי מעילה זריקה כתיקנה מייתי לידי מעילה",
      "sha256_utf8": "e98d7fbe3e063d8747e9be60faac135b5bcd951f22bb784075f65023008dfacb",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6a:19",
      "page_index": 10,
      "segment_index": 18,
      "start_char": 0,
      "end_char": 58,
      "quote": "כל לאפוקי מידי מעילה אפילו שלא כתיקנה נמי מפקע מידי מעילה:",
      "sha256_utf8": "15d1f48e1b7667d98988264f18a3054721dd6a4a295c697f4ce04b22d8bf3235",
      "cohort": "probability_core"
    },
    {
      "ref": "Meilah 6b:1",
      "page_index": 11,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 70,
      "quote": "<big><strong>מתני׳</strong></big> בשר קדשי קדשים שיצא לפני זריקת דמים ",
      "sha256_utf8": "dbe4c3366b3d383334bbd313067fbc333bc54d07fe203852c193ebf7db3c48a8",
      "cohort": "probability_core"
    },
    {
      "ref": "Meilah 6b:2",
      "page_index": 11,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 63,
      "quote": "ר' אליעזר אומר מועלין בו ואין חייבין עליו משום פיגול ונותר וטמא",
      "sha256_utf8": "71cd526ab14ee72fc71dbd683c5790c03e579e1792e49c3f6c4c29879494f070",
      "cohort": "probability_core"
    },
    {
      "ref": "Meilah 6b:3",
      "page_index": 11,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 58,
      "quote": "ר\"ע אומר  אין מועלין בו וחייבין עליו משום פיגול ונותר וטמא",
      "sha256_utf8": "6575ff476dd3c4021942f59990e25825997309902ac10e244908daa05aad5b44",
      "cohort": "probability_core"
    },
    {
      "ref": "Meilah 6b:4",
      "page_index": 11,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 90,
      "quote": "אמר ר\"ע  והרי המפריש חטאתו ואבדה והפריש אחרת תחתיה ואחר כך נמצאת הראשונה והרי שתיהן עומדות",
      "sha256_utf8": "0d769ac92226271503dc024050dc060f9bb995395a85150d04a45c6d95a5e428",
      "cohort": "probability_core"
    },
    {
      "ref": "Meilah 6b:5",
      "page_index": 11,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 49,
      "quote": "לא כשם שדמה פוטר את בשרה כך הוא פוטר את בשר חברתה",
      "sha256_utf8": "a75d4f1f5be4ac56162e402823d313b24bb0273c8b7c8e133166b1c428cd8fab",
      "cohort": "probability_core"
    },
    {
      "ref": "Meilah 6b:6",
      "page_index": 11,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 59,
      "quote": "אם פטר דמה את בשר חברתה מן המעילה דין הוא שיפטר את בשר עצמה",
      "sha256_utf8": "885beef88d8c202c910e780d352b0f2e84873045389b3c5418aa6c56a9f93361",
      "cohort": "probability_core"
    },
    {
      "ref": "Meilah 6b:7",
      "page_index": 11,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 39,
      "quote": "אימורי קדשים קלים שיצאו לפני זריקת דמים",
      "sha256_utf8": "bc1f5e4d4d5368ce13b3fffae514d3136ec3507f573b7fd39b1b4f988f1de96a",
      "cohort": "probability_core"
    },
    {
      "ref": "Meilah 6b:8",
      "page_index": 11,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 130,
      "quote": "רבי אליעזר אומר אין מועלין בהן ואין חייבין עליהן משום פיגול נותר וטמא רבי עקיבא אומר מועלין בהן וחייבין עליהן משום פיגול נותר וטמא",
      "sha256_utf8": "36d6ec63d3a3dd08fcf34b8b92b09c26fedea2860c3f029416dfe8a94ec14a17",
      "cohort": "probability_core"
    },
    {
      "ref": "Meilah 6b:9",
      "page_index": 11,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 48,
      "quote": "<big><strong>גמ׳</strong></big> והני תרתי למה לי",
      "sha256_utf8": "44f8067e79b87756d4eca9795a1242c7fdaff5ec24eb84dcc3c2f172937b611b",
      "cohort": "probability_core"
    },
    {
      "ref": "Meilah 6b:10",
      "page_index": 11,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 133,
      "quote": "צריכי דאי איתמר בקדשי קדשים הוה אמינא בהא קא אמר ר' אליעזר מועלין בו משום דזריקה כתיקנה מפקא מידי מעילה שלא כתיקנה לא מפקא מידי מעילה",
      "sha256_utf8": "e019e21e4f15f14bf5b4f726432f8d76f49968561774e1a3a6d27a02ef920cd1",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6b:11",
      "page_index": 11,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 68,
      "quote": "אבל לאיתויי לידי מעילה מודי לר\"ע דאפילו שלא כתיקנה מייתא לידי מעילה ",
      "sha256_utf8": "684dca3733314c8c6c2a5208d233eab83436e6762629e3aa15693c6b3f2dd22a",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6b:12",
      "page_index": 11,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 114,
      "quote": "ואי איתמר גבי קדשים קלים הוה אמינא גבי קדשים קלים הוא דאמר ר\"ע מועלין בהן דאפילו זריקה שלא כתיקנה מייתא לידי מעילה",
      "sha256_utf8": "60f2d56fa28f7de5775f7284fd0611c92752a5be13cf3c33ddb51f0f426355b0",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6b:13",
      "page_index": 11,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 62,
      "quote": "אבל קדשי קדשים דלאפוקי הוא שלא כתיקנה לא מפקא מידי מעילה קמ\"ל ",
      "sha256_utf8": "dab90f965e2bee0663e908204250b1a996073c1f8354e2435e8b51fe6f3a8e7d",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6b:14",
      "page_index": 11,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 83,
      "quote": "אתמר אמר ר' יוחנן כי אמר ר\"ע זריקה מועלת ליוצא שיצא מקצתו אבל יוצא כולו לא אמר ר\"ע ",
      "sha256_utf8": "e8febbdf67d19c829b40e85d7c6d7002fd348bc492a5428abbfb45a8171a95b8",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 6b:15",
      "page_index": 11,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 47,
      "quote": "א\"ל רב אסי לרבי יוחנן  כבר לימדוני חבירי שבגולה",
      "sha256_utf8": "53e926ef9e677b27c1477db95494a198f3f7dd9dcd37e2468b56dc779f5266ea",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:1",
      "page_index": 12,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 25,
      "quote": "מחשבין על האבוד ועל השרוף",
      "sha256_utf8": "7959b6170eac3d9399741227bbe89aabd7cdf889e21b85beaca5dc0a1e6fa5c4",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:2",
      "page_index": 12,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 50,
      "quote": "והא אבוד ושרוף לא איתינון בעולם ואפ\"ה קתני מחשבין ",
      "sha256_utf8": "e2aa4d2e77af0f1cd8db0b9586227db3fb3f47eed83bb283460c3de808e18193",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:3",
      "page_index": 12,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 70,
      "quote": "ומי אמר רב אסי הכי הא בעא מיניה רב אסי מר' יוחנן חישב לנשפכין למחר מהו",
      "sha256_utf8": "91bd1e12226f3e4c0aca265a009526d1762e2383d6acf3fd9a29dac3107ff6ed",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:4",
      "page_index": 12,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 76,
      "quote": "א\"ל רבי זירא  כבר שנית לנו אלל אלמא האי אלל כיון דלית ביה מששא לא קיבל טומאה",
      "sha256_utf8": "4d0bec39bc2b696d0a2826f8ea2419c5726039af7fb8ddc01bb67afeca6d9d3f",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:5",
      "page_index": 12,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 51,
      "quote": "הני נשפכין נמי כיון דלאיבוד אזלי בהו מחשבה לא מהניא",
      "sha256_utf8": "2e75a510be2bd7342691c4a760b88f7d7c611ec41eef70348d2652d3c753a33b",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:6",
      "page_index": 12,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 78,
      "quote": "אלא דקתני על האבוד ועל השרוף קשיא אמר רבא אימא על העומד לאיבוד ועל העומד לישרף",
      "sha256_utf8": "ced69abbd74b749d704887bbc48eba6593f18a38933b17871dd8eba7b2597632",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:7",
      "page_index": 12,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 84,
      "quote": "אמר רב פפא לא א\"ר עקיבא זריקה מועלת ליוצא אלא שיצא בשר אבל דם אין זריקה מועלת ליוצא ",
      "sha256_utf8": "2d43e3c12768866ea3e4378ec8363a2d73812f9197fc6aa100250f8c64f32af1",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:8",
      "page_index": 12,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 111,
      "quote": "תניא נמי הכי שחט בשתיקה ויצא דם אע\"פ שחזר וזרקו לא עשה ולא כלום בקדשי קדשים מועלין בו בקדשים קלים אין מועלין בו",
      "sha256_utf8": "604e4d54d077cdbf100e66a25ff3aba89b1ddb12a980369a3b0de93f9c170d08",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:9",
      "page_index": 12,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 25,
      "quote": "א\"ר עקיבא הא זה למה דומה ",
      "sha256_utf8": "80e508bb19155951f5da3c9cc8d239b2dc5d3e20713ae8681f9f20e3abb793b2",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:10",
      "page_index": 12,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 66,
      "quote": "אמר ר' אלעזר כי א\"ר עקיבא בבת אחת אבל בזה אחר זה לא אמר רבי עקיבא ",
      "sha256_utf8": "4b00c8369562e3d5c002dcdfbc543363e7a1659abda258a3cb0900f183957922",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:11",
      "page_index": 12,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 186,
      "quote": "תניא אמר רבי שמעון כשהלכתי לכפר פאני מצאני זקן אחד ואמר לי אומר היה ר' עקיבא זריקה מועלת ליוצא אמרתי לו הן וכשבאתי והרציתי דברים לפני חבירי שבגליל אמרו לי הלא פסול הוא היאך מרצה על הפסול",
      "sha256_utf8": "4fa17351b427576a35d25890214ac27d4354033353e5b9148ee5105c82091184",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7a:12",
      "page_index": 12,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 193,
      "quote": "וכשיצאתי והרציתי דברים לפני ר\"ע אמר לי  בני אי אתה אומר כן והרי המפריש חטאתו ואבדה והפריש אחרת תחתיה ואח\"כ נמצאת הראשונה והרי שתיהן עומדות מועלין בשתיהן  שחטן והרי דמן מונח בכוסות מועלין בשתיהן",
      "sha256_utf8": "338ec08841972a6d35a39ab8a6f01e2d492127b353b6f01f573dda0f37a299d8",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7b:1",
      "page_index": 13,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 93,
      "quote": "נזרק דם של אחד מהם אי אתה מודה שכשם שדמה פוטר את בשרה מן המעילה אף יפטור בשר חבירתה מן המעילה",
      "sha256_utf8": "6f96b810c6eb172d952adf9e00931639a56f549b67a9b029aac482b49648cdef",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7b:2",
      "page_index": 13,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 69,
      "quote": "אם הציל בשר חבירתה מן המעילה אף על פי שהוא פסול דין הוא שיציל את בשרה",
      "sha256_utf8": "b618af3fc218cc6ddf4be1c54e0b79ae740ed27045c3471b3143df6d986307d8",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7b:3",
      "page_index": 13,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 93,
      "quote": "אמר ריש לקיש משום רב אושעיא תשובה גנובה השיבו רבי עקיבא לאותו תלמיד בבת אחת אין בזה אחר זה לא",
      "sha256_utf8": "16de50276c0a5b3d458b7d64db5e4d9d53d91c1336194ba1cbed8b250de65f72",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7b:4",
      "page_index": 13,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 46,
      "quote": "דכיון דפסול הוא מה לי בבת אחת מה לי בזה אחר זה",
      "sha256_utf8": "fa3f5a6a9b05a04b851082aef4b6b0a17070072587bf89bb50feddcfd21aa8e4",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7b:5",
      "page_index": 13,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 44,
      "quote": "א\"ל רבי יוחנן לריש לקיש  ואתה אי אתה אומר כן",
      "sha256_utf8": "23ef174c093ea0fa09fe21f1bb3252c5d7767de39c71cfa310912c428c4fc69a",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7b:6",
      "page_index": 13,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 108,
      "quote": "אילו הפריש שתי אשמות לאחריות ושחט את שניהן וקדם והעלה אימורין של אחד מהן קודם זריקה אי אתה מודה שאם עלו ירדו",
      "sha256_utf8": "173d89e555c1b773c07eff5ef87215ffe8de05831538cb47f2d3c3a745b6dffd",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7b:7",
      "page_index": 13,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 111,
      "quote": "ואי ס\"ד חד גופא הוא אמאי אם עלו ירדו  האמר עולא אימורי קדשים קלים שהעלן לפני זריקת דם לא ירדו נעשה לחמו של מזבח",
      "sha256_utf8": "a4e0b1a714d1db3e9a83689f84c39795d2411987943575df912c41ee638fdfb3",
      "cohort": "context_expansion"
    },
    {
      "ref": "Meilah 7b:8",
      "page_index": 13,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 43,
      "quote": "אישתיק אמר ר' יוחנן קצצתינון לרגלוהי דינוקא",
      "sha256_utf8": "5f88164d8dd8af31ec219c7c630b791d6e0baa2b92e8bbb33ec87ae4fca6b2a4",
      "cohort": "context_expansion"
    }
  ],
