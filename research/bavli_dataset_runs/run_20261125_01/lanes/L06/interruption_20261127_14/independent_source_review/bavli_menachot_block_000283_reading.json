      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 85b:19",
      "page_index": 169,
      "segment_index": 18,
      "start_char": 0,
      "end_char": 51,
      "quote": "אין מביאין לא מבית הזבלים: והתניא אין מביאין אנפקטן",
