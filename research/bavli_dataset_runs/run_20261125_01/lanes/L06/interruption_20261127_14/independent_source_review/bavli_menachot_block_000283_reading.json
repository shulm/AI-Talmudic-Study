    {
      "ref": "Menachot 86a:1",
      "page_index": 170,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 49,
      "quote": "ואם הביא פסול (והתניא ואם הביא כשר) מפני שהוא שרף",
