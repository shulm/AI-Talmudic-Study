      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 91b:11",
      "page_index": 181,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 53,
      "quote": "רבא אמר איזהו דבר שצריך שלשה רבויין הוי אומר זו מצורע",
