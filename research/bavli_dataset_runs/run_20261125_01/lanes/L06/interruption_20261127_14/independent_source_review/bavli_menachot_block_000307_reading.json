      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 91b:12",
      "page_index": 181,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 41,
      "quote": "לאיל למה לי אמר רב ששת לרבות אילו של אהרן",
