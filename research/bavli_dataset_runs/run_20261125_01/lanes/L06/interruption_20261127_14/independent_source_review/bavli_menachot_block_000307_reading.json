      "page_index": 181,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 71,
      "quote": "אילו של אהרן מבמועדיכם נפקא סלקא דעתך אמינא הני מילי דצבור אבל דיחיד לא",
      "sha256_utf8": "b9c2b8bc62f6668da4815979847739c8065344cfd88716225dee4c96b18c928c",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 91b:14",
      "page_index": 181,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 20,
