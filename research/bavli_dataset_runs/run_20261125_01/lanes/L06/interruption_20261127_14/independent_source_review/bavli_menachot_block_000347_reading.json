  "evidence": [
    {
      "ref": "Menachot 102b:10",
      "page_index": 203,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 117,
      "quote": "<big><strong>מתני׳</strong></big> האומר הרי עלי במחבת והביא במרחשת במרחשת והביא במחבת מה שהביא הביא וידי חובתו לא יצא",
      "sha256_utf8": "3c9888fe5598770d8935f10813d554721bbd4abcee85ea1001a08d32334a8f49",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 102b:11",
      "page_index": 203,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 59,
      "quote": "זו להביא במחבת והביא במרחשת במרחשת והביא במחבת הרי זו פסולה",
      "sha256_utf8": "ec4b987c036fd76341975d4b15bbe1e772aaebee010528e91c142b26c675a1fd",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 102b:12",
      "page_index": 203,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 113,
      "quote": "האומר הרי עלי שני עשרונות להביא בכלי אחד והביא בשני כלים בשני כלים והביא בכלי אחד מה שהביא הביא וידי חובתו לא יצא",
      "sha256_utf8": "b9df3e3b47fe4399248f143ed452da57cc4272bcc453324c571da4179f50633b",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 102b:13",
      "page_index": 203,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 68,
      "quote": "אלו בכלי אחד והביא בשני כלים בשני כלים והביא בכלי אחד הרי אלו פסולין",
      "sha256_utf8": "109e8f408c5339219225c5fa0b8ee143536e9f7ae849568d0987a01e7aad63d2",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 102b:14",
      "page_index": 203,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 111,
      "quote": "הרי עלי שני עשרונות להביא בכלי אחד והביא בשני כלים אמרו לו בכלי אחד נדרת הקריבן בשני כלים פסולין בכלי אחד כשרין",
      "sha256_utf8": "1bb31853ea85ff62e20b658a441ac95a0764114a779d4155f87a72352755a769",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 102b:15",
      "page_index": 203,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 130,
      "quote": "הרי עלי שני עשרונות להביא בשני כלים והביא בכלי אחד אמרו לו בשני כלים נדרת הקריבן בשני כלים כשרין נתנו לכלי אחד כשתי מנחות שנתערבו:",
      "sha256_utf8": "6e96414a97bdf6dd306be51a460312fb27b860a1bb43e9d1a7b962dee6369b1d",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 102b:16",
      "page_index": 203,
      "segment_index": 15,
      "start_char": 0,
      "end_char": 42,
      "quote": "<big><strong>גמ׳</strong></big> וצריכא דאי",
      "sha256_utf8": "1eab224d85d065a3f0cc0061ad68ce55ac5c6344905cdd329aed8c50d55a0651",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 102b:17",
      "page_index": 203,
      "segment_index": 16,
      "start_char": 0,
      "end_char": 117,
      "quote": "אשמעינן הך קמייתא משום דאמר במחבת וקא מייתי במרחשת אבל הכא דאידי ואידי במחבת ואידי ואידי במרחשת אימא ידי נדרו נמי יצא",
      "sha256_utf8": "4c309dce49639ac5634d96ed8d26b68a7487f01400b09d78cc33791e3793bf14",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 102b:18",
      "page_index": 203,
      "segment_index": 17,
      "start_char": 0,
      "end_char": 67,
      "quote": "ואי אשמעינן הך משום דקא פליג להו אבל התם דלא פליג ביה אימא לא צריכא",
      "sha256_utf8": "fee0829d87cc9d6a24571242cb31b5a44daac4433fe279c2d4c6369aa6f404e1",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 102b:19",
      "page_index": 203,
      "segment_index": 18,
      "start_char": 0,
      "end_char": 74,
      "quote": "תנו רבנן מה שהביא הביא וידי נדרו לא יצא ר' שמעון אומר אף ידי נדרו נמי יצא:",
      "sha256_utf8": "f8b22c30616dcd88d8638376cce588903e55c46cbbf8d79a74ec8d1507fd7ac3",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 102b:20",
      "page_index": 203,
      "segment_index": 19,
      "start_char": 0,
      "end_char": 84,
      "quote": "זו להביא במחבת: והא תניא לא קידשום כלי שרת אמר אביי לא קידשום ליקרב אבל קידשום ליפסל",
      "sha256_utf8": "37fba89efbf62eb83ad031a9690bd49e29607b4e6329be794ef2d76fde44acd6",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 102b:21",
      "page_index": 203,
      "segment_index": 20,
      "start_char": 0,
      "end_char": 16,
      "quote": "ואמר אביי לא שנו",
      "sha256_utf8": "fa32635f3e9c1e8103d929de0594c5f56733f6f445eca7e1ef845d129f0def72",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 103a:1",
      "page_index": 204,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 36,
      "quote": "אלא שקבען בשעת נדר אבל בשעת הפרשה לא",
      "sha256_utf8": "7cbd048c63b6655ad41953d9863d6ebd61c9e16b065887be14ea2abde66d512a",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 103a:2",
      "page_index": 204,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 39,
      "quote": "(דברים כג, כד) כאשר נדרת ולא כאשר הפרשת",
      "sha256_utf8": "0536d598d858b5ecfd2151cdd1c62c1bd515730d5ff2b05629c0ee070063c0a6",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 103a:3",
      "page_index": 204,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 126,
      "quote": "איתמר נמי אמר רבי אחא בר חנינא אמר רבי אסי אמר רבי יוחנן לא שנו אלא שקבען בשעת נדר אבל בשעת הפרשה לא כאשר נדרת ולא כאשר הפרשת:",
      "sha256_utf8": "e4e8363463350f558283275a4e5b199a8ea63c12b2a0975c2790099ea552304a",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 103a:4",
      "page_index": 204,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 126,
      "quote": "<big><strong>מתני׳</strong></big> האומר הרי עלי מנחה מן השעורים יביא מן החטים קמח יביא סולת בלא שמן ובלא לבונה יביא שמן ולבונה",
      "sha256_utf8": "0ec5fc87441807d1975c3159a59a2ea312919883807872bb7f8b141b831592d4",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 103a:5",
      "page_index": 204,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 86,
      "quote": "חצי עשרון יביא עשרון שלם עשרון ומחצה יביא שנים רבי שמעון פוטר שלא התנדב כדרך המתנדבין:",
      "sha256_utf8": "c292728f6081063f577c414fc9684d30de2575b154bb5dc8b0a5269ef29cf862",
      "cohort": "probability_core"
    },
    {
      "ref": "Menachot 103a:6",
      "page_index": 204,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 54,
      "quote": "<big><strong>גמ׳</strong></big> אמאי נדר ופתחו עמו הוא",
      "sha256_utf8": "fd3b2998ec151aa8f378ab2715e7dd3eebc63065b4f6da7787ec1f481848da23",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103a:7",
      "page_index": 204,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 137,
      "quote": "אמר חזקיה הא מני בית שמאי היא דאמרי תפוס לשון ראשון דתנן הריני נזיר מן הגרוגרות ומן הדבילה בית שמאי אומרים נזיר ובית הלל אומרים אינו נזיר",
      "sha256_utf8": "2a554cafb02313e21c36e0970c61c8c2040845aeb62ddea44e5520de75eb6773",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103a:8",
      "page_index": 204,
      "segment_index": 7,
      "start_char": 0,
      "end_char": 92,
      "quote": "ר' יוחנן אמר אפילו תימא בית הלל באומר אילו הייתי יודע שאין נודרין כך לא הייתי נודר כך אלא כך",
      "sha256_utf8": "79a2dd29afa9ec24e8b7d268141a68a25f7c97558174b0ac5428f46b9e114a1c",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103a:9",
      "page_index": 204,
      "segment_index": 8,
      "start_char": 0,
      "end_char": 67,
      "quote": "אמר חזקיה לא שנו אלא דאמר מנחה מן השעורים אבל אמר מנחה מן העדשים לא",
      "sha256_utf8": "b8afed82088eb87c60f8dcdfe0f7d67a5d93d7491ca0faf4d23149ee661aeef7",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103a:10",
      "page_index": 204,
      "segment_index": 9,
      "start_char": 0,
      "end_char": 113,
      "quote": "מכדי חזקיה כמאן אמר לשמעתיה כבית שמאי ובית שמאי משום תפוס לשון ראשון הוא מה לי מן השעורין מה לי מן העדשים הדר ביה",
      "sha256_utf8": "3237e619dfd3b9c1b8e87a4b49cce7d75a4815e34601c05e6d18cb3095ad313e",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103a:11",
      "page_index": 204,
      "segment_index": 10,
      "start_char": 0,
      "end_char": 87,
      "quote": "ומאי טעמא הדר ביה אמר רבא מתניתין קשיתיה מאי איריא דתני מנחה מן השעורים ליתני מן העדשים",
      "sha256_utf8": "2a6ab91ab381651ae2b5f1fd66d93b19395080aca3af1051f20fb86223780a2d",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103a:12",
      "page_index": 204,
      "segment_index": 11,
      "start_char": 0,
      "end_char": 52,
      "quote": "אלא שמע מינה משום דטעי הוא בשעורים טעי בעדשים לא טעי",
      "sha256_utf8": "b3b46c3a833137bc64e2afbcfd4e5a19308d78717a66abbc5e4d522ead235e79",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103a:13",
      "page_index": 204,
      "segment_index": 12,
      "start_char": 0,
      "end_char": 120,
      "quote": "ורבי יוחנן אמר אפילו מן העדשים מכדי ר' יוחנן כמאן אמרה לשמעתיה כבית הלל ובית הלל משום דטעי הוא בשעורין טעי בעדשים לא טעי",
      "sha256_utf8": "e49378ce356790e341a7dbb9afa78bbaf199e1f514672b26032aae59a5938a05",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103a:14",
      "page_index": 204,
      "segment_index": 13,
      "start_char": 0,
      "end_char": 66,
      "quote": "לדבריו דחזקיה קאמר ליה את מאי טעמא הדרת בך משום דלא קתני מן העדשים",
      "sha256_utf8": "f32fed3e1da6212ed0f971113b3eb0a66a0c7cd808ce182c7f835835f8f10174",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103a:15",
      "page_index": 204,
      "segment_index": 14,
      "start_char": 0,
      "end_char": 167,
      "quote": "דלמא לא מיבעיא קאמר לא מיבעיא מן העדשים דאיכא למימר מהדר הוא דהדר ביה ותפוס לשון ראשון אלא אפילו מן השעורין נמי דאיכא למימר מיטעא הוא דקא טעי אפילו הכי תפוס לשון ראשון",
      "sha256_utf8": "313fea017030dd27c7eb0126f2002dff7eb27f36bd3009a7ff5e10b444e71f4d",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103b:1",
      "page_index": 205,
      "segment_index": 0,
      "start_char": 0,
      "end_char": 49,
      "quote": "אמר זעירי לא שנו אלא דאמר מנחה אבל לא אמר מנחה לא",
      "sha256_utf8": "f34abf1c6c2f1656cf5dd5473265f59d07317075d13d28a9504f4989ab301bcb",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103b:2",
      "page_index": 205,
      "segment_index": 1,
      "start_char": 0,
      "end_char": 96,
      "quote": "יתיב רב נחמן וקאמר לה להא שמעתא איתיביה רבא לרב נחמן קמח יביא סולת לאו דלא אמר מנחה לא דאמר מנחה",
      "sha256_utf8": "d599ed0f819095d4aa3cdd8a13b19fc0b3f747c23cb4ed8176f88c005fac2963",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103b:3",
      "page_index": 205,
      "segment_index": 2,
      "start_char": 0,
      "end_char": 64,
      "quote": "בלא שמן ולבונה יביא שמן ולבונה מאי לאו דלא אמר מנחה לא דאמר מנחה",
      "sha256_utf8": "fd9d5eea1a5c690417c9dbb4d6f6f9eeb579fb46042d8c76c7df4d176b0250ee",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103b:4",
      "page_index": 205,
      "segment_index": 3,
      "start_char": 0,
      "end_char": 58,
      "quote": "חצי עשרון יביא עשרון שלם מאי לאו דלא אמר מנחה לא דאמר מנחה",
      "sha256_utf8": "036a1e1630a3b0b7771915c46f4721720572332a74d2a4f339ac9bc3d49ad8c7",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103b:5",
      "page_index": 205,
      "segment_index": 4,
      "start_char": 0,
      "end_char": 105,
      "quote": "אי הכי אימא סיפא עשרון ומחצה יביא שנים כיון דאמר מנחה איחייב ליה בעשרון כי אמר חצי עשרון לא כלום קאמר הוא",
      "sha256_utf8": "ca9cf2f2cb91e27c8e3154d0e246877b65b327bcdcee9f9f7f77467df7679330",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103b:6",
      "page_index": 205,
      "segment_index": 5,
      "start_char": 0,
      "end_char": 144,
      "quote": "לא צריכא דאמר הרי עלי מנחה חצי עשרון ועשרון דכיון דאמר מנחה איחייב ליה בעשרון כי אמר חצי עשרון ולא כלום קאמר כי הדר אמר עשרון מייתי עשרון אחרינא",
      "sha256_utf8": "39791d95b7d33f59b41c38bce65c9c36bd0b0d791ebef17a95c84aec8a9d442d",
      "cohort": "context_expansion"
    },
    {
      "ref": "Menachot 103b:7",
      "page_index": 205,
      "segment_index": 6,
      "start_char": 0,
      "end_char": 118,
      "quote": "אי הכי רבי שמעון פוטר שלא התנדב כדרך המתנדבין אמאי אמר רבא ר' שמעון בשיטת ר' יוסי אמרה דאמר [אף] בגמר דבריו אדם מתפיס:",
      "sha256_utf8": "501b5248870252838d06272ec07ac04791c3fafa9e61853d13113b0d293caafe",
      "cohort": "context_expansion"
    }
  ],
