        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "ref",
              "start_char",
              "end_char",
              "quote",
              "source_sha256"
