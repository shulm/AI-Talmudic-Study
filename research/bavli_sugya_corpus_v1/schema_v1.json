      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string"
        },
        "tractate": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "source_index": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
