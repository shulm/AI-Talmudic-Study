{"record_type": "relation", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "sugya_id": "sugya:bavli:bava_metzia:22b:11__22b:16", "relation_id": "rel:bavli:bava_metzia:22b:13:r01", "from_id": "stmt:bavli:bava_metzia:22b:13:s01", "to_id": "stmt:bavli:bava_metzia:22b:11:s02", "relation_type": "objects_to", "source_spans": [{"segment_id": "seg:bavli:bava_metzia:22b:13", "start_char": 107, "end_char": 204, "quote": "אלא לאו דאית בהו סימן וקתני ברשות הרבים הרי אלו שלו אלמא סימן העשוי לידרס לא הוי סימן תיובתא דרבא", "quote_sha256": "b00e9526dc5a0f34a7d13c35629335b42767795ca4b2b322411fab53faf4acda", "alignment_status": "exact"}], "relation_status": "explicit", "rationale": "Raises an apparent תיובתא against Rava from the baraita of כריכות."}
