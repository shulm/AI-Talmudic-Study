{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:22b:8:s01", "sugya_id": "sugya:bavli:bava_metzia:21a:19__22b:10", "sub_sugya_id": "subsugya:bavli:bava_metzia:22b:8__22b:10:tamrei_dezika_post_tiyuvta", "source_spans": [{"segment_id": "seg:bavli:bava_metzia:22b:8", "start_char": 85, "end_char": 154, "quote": "אמר ליה כיון דאיכא שקצים ורמשים דקא אכלי להו מעיקרא יאושי מיאש מנייהו", "quote_sha256": "8c09f76ae43ac005dc0fdfb10a74ff5539b23f4ecc6d0510cc00948103f7720c", "alignment_status": "exact"}, {"segment_id": "seg:bavli:bava_metzia:22b:10", "start_char": 0, "end_char": 39, "quote": "מוחזק ועומד מאי כרכתא מאי אמר ליה אסירן", "quote_sha256": "86325fa3c0e42c78cb040c4264144c0dbd0ba8cc258186afabf5cb4bd0bcc26a", "alignment_status": "exact"}], "source_quote": "אמר ליה כיון דאיכא שקצים ורמשים דקא אכלי להו מעיקרא יאושי מיאש מנייהו ... מוחזק ועומד מאי כרכתא מאי אמר ליה אסירן", "alignment_status": "exact", "speaker_kind": "named_scholar", "speaker_id": "scholar:amora:rav_ashi", "reported_by_id": null, "transmission_chain_ids": [], "quoted_source_type": "none", "attributed_to_ids": ["scholar:amora:rav_ashi"], "attribution_type": "explicit_direct", "speech_act": "answer", "interpretation_status": "qualified_conditional", "annotator_paraphrase": null, "is_annotator_paraphrase": false, "textual_variant_notes": null}
{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:22b:11:s01", "sugya_id": "sugya:bavli:bava_metzia:22b:11__22b:16", "sub_sugya_id": null, "source_spans": [{"segment_id": "seg:bavli:bava_metzia:22b:11", "start_char": 31, "end_char": 105, "quote": "אמר רבה ואפילו בדבר שיש בו סימן אלמא קסבר רבה סימן העשוי לידרס לא הוי סימן", "quote_sha256": "f392cd93340cbcf477553ae5b587a90747b174351856212fab8bdd45a5d3d709", "alignment_status": "exact"}], "source_quote": "אמר רבה ואפילו בדבר שיש בו סימן אלמא קסבר רבה סימן העשוי לידרס לא הוי סימן", "alignment_status": "exact", "speaker_kind": "named_scholar", "speaker_id": "scholar:amora:rabbah", "reported_by_id": null, "transmission_chain_ids": [], "quoted_source_type": "none", "attributed_to_ids": ["scholar:amora:rabbah"], "attribution_type": "explicit_direct", "speech_act": "proposition", "interpretation_status": "asserted", "annotator_paraphrase": null, "is_annotator_paraphrase": false, "textual_variant_notes": null}
