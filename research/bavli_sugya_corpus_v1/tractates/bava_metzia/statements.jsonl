{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:22a:11:s01", "sugya_id": "sugya:bavli:bava_metzia:21a:19__22b:10", "sub_sugya_id": "subsugya:bavli:bava_metzia:22a:10__22a:11:mari_bar_isak_orchard_maaseh", "source_spans": [{"segment_id": "seg:bavli:bava_metzia:22a:11", "start_char": 92, "end_char": 212, "quote": "אמר להו הכי אמר רבא לא אמרו כלך אצל יפות אלא לענין תרומה בלבד משום דמצוה הוא וניחא ליה אבל הכא משום כסיפותא הוא דאמר הכי", "quote_sha256": "6f4993ec3717823c177de667f587df68ff4c01221ee3f2b9418b9b7377529d4f", "alignment_status": "exact"}], "source_quote": "אמר להו הכי אמר רבא לא אמרו כלך אצל יפות אלא לענין תרומה בלבד משום דמצוה הוא וניחא ליה אבל הכא משום כסיפותא הוא דאמר הכי", "alignment_status": "exact", "speaker_kind": "named_scholar", "speaker_id": "scholar:amora:mar_zutra", "reported_by_id": "scholar:amora:mar_zutra", "transmission_chain_ids": ["scholar:amora:mar_zutra", "scholar:amora:rava"], "quoted_source_type": "none", "attributed_to_ids": ["scholar:amora:rava"], "attribution_type": "explicit_transmitted", "speech_act": "qualification", "interpretation_status": "asserted", "annotator_paraphrase": null, "is_annotator_paraphrase": false, "textual_variant_notes": null}
{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:22b:5:s01", "sugya_id": "sugya:bavli:bava_metzia:21a:19__22b:10", "sub_sugya_id": null, "source_spans": [{"segment_id": "seg:bavli:bava_metzia:22b:5", "start_char": 0, "end_char": 80, "quote": "תא שמע דאמר רבי יוחנן משום רבי ישמעאל בן יהוצדק מנין לאבידה ששטפה נהר שהיא מותרת", "quote_sha256": "dbe4b4c40a0d648f99166df59da80959d3a61b3418d55ace04151e5c163d8a70", "alignment_status": "exact"}], "source_quote": "תא שמע דאמר רבי יוחנן משום רבי ישמעאל בן יהוצדק מנין לאבידה ששטפה נהר שהיא מותרת", "alignment_status": "exact", "speaker_kind": "named_scholar", "speaker_id": "scholar:amora:rabbi_yohanan", "reported_by_id": "scholar:amora:rabbi_yohanan", "transmission_chain_ids": ["scholar:amora:rabbi_yohanan", "scholar:tanna:rabbi_yishmael_ben_yehotzadak"], "quoted_source_type": "none", "attributed_to_ids": ["scholar:tanna:rabbi_yishmael_ben_yehotzadak"], "attribution_type": "explicit_transmitted", "speech_act": "proof", "interpretation_status": "asserted", "annotator_paraphrase": null, "is_annotator_paraphrase": false, "textual_variant_notes": null}
