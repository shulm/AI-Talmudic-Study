{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:21a:4:s01", "sugya_id": "sugya:bavli:bava_metzia:21a:1__21a:6", "sub_sugya_id": "subsugya:bavli:bava_metzia:21a:4__21a:5:gufa_simpon_edim_shalish", "source_spans": [{"segment_id": "seg:bavli:bava_metzia:21a:4", "start_char": 0, "end_char": 103, "quote": "גופא סמפון שיש עליו עדים יתקיים בחותמיו אין עליו עדים ויוצא מתחת ידי שליש או שיוצא לאחר חיתום שטרות כשר", "quote_sha256": "5c5acdd2b4ef9afef1aa12497fb5d7af1b03806359bd2c6b7c0c9a538429ee77", "alignment_status": "exact"}], "source_quote": "גופא סמפון שיש עליו עדים יתקיים בחותמיו אין עליו עדים ויוצא מתחת ידי שליש או שיוצא לאחר חיתום שטרות כשר", "alignment_status": "exact", "speaker_kind": "tannaitic_anonymous", "speaker_id": null, "reported_by_id": null, "transmission_chain_ids": [], "quoted_source_type": "baraita", "attributed_to_ids": [], "attribution_type": "anonymous_tannaitic", "speech_act": "proposition", "interpretation_status": "asserted", "annotator_paraphrase": null, "is_annotator_paraphrase": false, "textual_variant_notes": null}
{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:21a:8:s01", "sugya_id": "sugya:bavli:bava_metzia:21a:7__21a:10", "sub_sugya_id": null, "source_spans": [{"segment_id": "seg:bavli:bava_metzia:21a:8", "start_char": 0, "end_char": 64, "quote": "אלו מציאות שלו מצא פירות מפוזרין מעות מפוזרות כריכות ברשות הרבים", "quote_sha256": "2126fe68851d220df63f06e11f7245b9d2ef3d201ed9e108bd4c2c02db3c25b3", "alignment_status": "exact"}, {"segment_id": "seg:bavli:bava_metzia:21a:8", "start_char": 179, "end_char": 204, "quote": "הרי אלו שלו דברי רבי מאיר", "quote_sha256": "61b8a494fad72d9986934f2ccc48c4df630e23472310092596e6f5b360170baa", "alignment_status": "exact"}], "source_quote": "אלו מציאות שלו מצא פירות מפוזרין מעות מפוזרות כריכות ברשות הרבים ... הרי אלו שלו דברי רבי מאיר", "alignment_status": "exact", "speaker_kind": "named_scholar", "speaker_id": "scholar:tanna:rabbi_meir", "reported_by_id": null, "transmission_chain_ids": [], "quoted_source_type": "mishnah", "attributed_to_ids": ["scholar:tanna:rabbi_meir"], "attribution_type": "explicit_direct", "speech_act": "proposition", "interpretation_status": "asserted", "annotator_paraphrase": null, "is_annotator_paraphrase": false, "textual_variant_notes": null}
{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:21a:9:s01", "sugya_id": "sugya:bavli:bava_metzia:21a:7__21a:10", "sub_sugya_id": null, "source_spans": [{"segment_id": "seg:bavli:bava_metzia:21a:9", "start_char": 0, "end_char": 83, "quote": "רבי יהודה אומר כל שיש בו שינוי חייב להכריז כיצד מצא עגול ובתוכו חרס ככר ובתוכו מעות", "quote_sha256": "75242a8bcf591c7ca80f941bb28d7b8f50030061075353cd2424c1fdfba5ebe3", "alignment_status": "exact"}], "source_quote": "רבי יהודה אומר כל שיש בו שינוי חייב להכריז כיצד מצא עגול ובתוכו חרס ככר ובתוכו מעות", "alignment_status": "exact", "speaker_kind": "named_scholar", "speaker_id": "scholar:tanna:rabbi_yehuda", "reported_by_id": null, "transmission_chain_ids": [], "quoted_source_type": "mishnah", "attributed_to_ids": ["scholar:tanna:rabbi_yehuda"], "attribution_type": "explicit_direct", "speech_act": "proposition", "interpretation_status": "asserted", "annotator_paraphrase": null, "is_annotator_paraphrase": false, "textual_variant_notes": null}
{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:21a:10:s01", "sugya_id": "sugya:bavli:bava_metzia:21a:7__21a:10", "sub_sugya_id": null, "source_spans": [{"segment_id": "seg:bavli:bava_metzia:21a:10", "start_char": 0, "end_char": 54, "quote": "רבי שמעון בן אלעזר אומר כל כלי אנפוריא אין חייב להכריז", "quote_sha256": "79d6f3ce45f80630c2cd165bef23c4ee62a63d1c0de043bb0a4472dc6abead74", "alignment_status": "exact"}], "source_quote": "רבי שמעון בן אלעזר אומר כל כלי אנפוריא אין חייב להכריז", "alignment_status": "exact", "speaker_kind": "named_scholar", "speaker_id": "scholar:tanna:rabbi_shimon_ben_elazar", "reported_by_id": null, "transmission_chain_ids": [], "quoted_source_type": "mishnah", "attributed_to_ids": ["scholar:tanna:rabbi_shimon_ben_elazar"], "attribution_type": "explicit_direct", "speech_act": "proposition", "interpretation_status": "asserted", "annotator_paraphrase": null, "is_annotator_paraphrase": false, "textual_variant_notes": null}
