{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:21a:13:s01", "sugya_id": "sugya:bavli:bava_metzia:21a:11__21a:18", "sub_sugya_id": null, "source_spans": [{"segment_id": "seg:bavli:bava_metzia:21a:13", "start_char": 0, "end_char": 121, "quote": "אמר רב עוקבא בר חמא במכנשתא דבי דרי עסקינן קב בארבע אמות דנפיש טרחייהו לא טרח איניש ולא הדר אתי ושקיל להו אפקורי מפקר להו", "quote_sha256": "53a2863f6b4c3d4db9e720648617f64f785410b21a4f2668b55ffedb32daf47b", "alignment_status": "exact"}], "source_quote": "אמר רב עוקבא בר חמא במכנשתא דבי דרי עסקינן קב בארבע אמות דנפיש טרחייהו לא טרח איניש ולא הדר אתי ושקיל להו אפקורי מפקר להו", "alignment_status": "exact", "speaker_kind": "named_scholar", "speaker_id": "scholar:amora:rav_ukva_bar_chama", "reported_by_id": null, "transmission_chain_ids": [], "quoted_source_type": "none", "attributed_to_ids": ["scholar:amora:rav_ukva_bar_chama"], "attribution_type": "explicit_direct", "speech_act": "qualification", "interpretation_status": "asserted", "annotator_paraphrase": null, "is_annotator_paraphrase": false, "textual_variant_notes": null}
{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:21a:14:s01", "sugya_id": "sugya:bavli:bava_metzia:21a:11__21a:18", "sub_sugya_id": null, "source_spans": [{"segment_id": "seg:bavli:bava_metzia:21a:14", "start_char": 0, "end_char": 34, "quote": "בעי רבי ירמיה חצי קב בשתי אמות מהו", "quote_sha256": "7b09d89e7168836b2bc9305345f8e1a16b0078f880ff86e8c9b00ea1c6f021bd", "alignment_status": "exact"}, {"segment_id": "seg:bavli:bava_metzia:21a:18", "start_char": 103, "end_char": 111, "quote": "מאי תיקו", "quote_sha256": "8f42ca0408ffe548c3692738217f5e922369dcff2c0c787fa9247d6a354830c7", "alignment_status": "exact"}], "source_quote": "בעי רבי ירמיה חצי קב בשתי אמות מהו ... מאי תיקו", "alignment_status": "exact", "speaker_kind": "named_scholar", "speaker_id": "scholar:amora:rabbi_yirmiyah", "reported_by_id": null, "transmission_chain_ids": [], "quoted_source_type": "none", "attributed_to_ids": ["scholar:amora:rabbi_yirmiyah"], "attribution_type": "explicit_direct", "speech_act": "question", "interpretation_status": "unresolved_kashya", "annotator_paraphrase": null, "is_annotator_paraphrase": false, "textual_variant_notes": null}
{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:21b:1:s01", "sugya_id": "sugya:bavli:bava_metzia:21a:19__22b:10", "sub_sugya_id": null, "source_spans": [{"segment_id": "seg:bavli:bava_metzia:21b:1", "start_char": 0, "end_char": 34, "quote": "יאוש שלא מדעת אביי אמר לא הוי יאוש", "quote_sha256": "4da8bcfd63c17a9d51ff63dcf27b67e7f73068de74f366267dc2a70f5f8aedcc", "alignment_status": "exact"}, {"segment_id": "seg:bavli:bava_metzia:21b:4", "start_char": 27, "end_char": 69, "quote": "אביי אמר לא הוי יאוש דהא לא ידע דנפל מיניה", "quote_sha256": "1c31e3be596d73eade5d01c00643eee3ee1e5f3ed88016588642b013a12b3689", "alignment_status": "exact"}], "source_quote": "יאוש שלא מדעת אביי אמר לא הוי יאוש ... אביי אמר לא הוי יאוש דהא לא ידע דנפל מיניה", "alignment_status": "exact", "speaker_kind": "named_scholar", "speaker_id": "scholar:amora:abaye", "reported_by_id": null, "transmission_chain_ids": [], "quoted_source_type": "none", "attributed_to_ids": ["scholar:amora:abaye"], "attribution_type": "explicit_direct", "speech_act": "proposition", "interpretation_status": "asserted", "annotator_paraphrase": null, "is_annotator_paraphrase": false, "textual_variant_notes": null}
{"record_type": "statement", "schema_version": "1.0.0", "source_version_id": "sefaria-export-2025-03-18:bavli:william-davidson-aramaic:v1", "statement_id": "stmt:bavli:bava_metzia:21b:1:s02", "sugya_id": "sugya:bavli:bava_metzia:21a:19__22b:10", "sub_sugya_id": null, "source_spans": [{"segment_id": "seg:bavli:bava_metzia:21b:1", "start_char": 35, "end_char": 52, "quote": "ורבא אמר הוי יאוש", "quote_sha256": "7ca65106db59b703a6d35478175c712d0e0eae42e0441bc2302c32516ad093cb", "alignment_status": "exact"}, {"segment_id": "seg:bavli:bava_metzia:21b:4", "start_char": 70, "end_char": 155, "quote": "רבא אמר הוי יאוש דלכי ידע דנפל מיניה מיאש מימר אמר סימנא לית לי בגויה מהשתא הוא דמיאש", "quote_sha256": "8d9f374bce53ad134a37d55b6d4e88d11f880c94349ac168a79ea23bf170170d", "alignment_status": "exact"}], "source_quote": "ורבא אמר הוי יאוש ... רבא אמר הוי יאוש דלכי ידע דנפל מיניה מיאש מימר אמר סימנא לית לי בגויה מהשתא הוא דמיאש", "alignment_status": "exact", "speaker_kind": "named_scholar", "speaker_id": "scholar:amora:rava", "reported_by_id": null, "transmission_chain_ids": [], "quoted_source_type": "none", "attributed_to_ids": ["scholar:amora:rava"], "attribution_type": "explicit_direct", "speech_act": "proposition", "interpretation_status": "refuted_tiyuvta", "annotator_paraphrase": "Refuted explicitly at Bava Metzia 22b:6 ('תיובתא דרבא תיובתא'); preserved as Rava's historical rejected position.", "is_annotator_paraphrase": true, "textual_variant_notes": null}
