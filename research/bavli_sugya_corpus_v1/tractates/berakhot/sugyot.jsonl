": {"segment_id": "seg:bavli:berakhot:4a:7", "start_char": 89, "end_char": 136, "quote": "למחר כחצות הלילה כי האידנא אני יוצא בתוך מצרים:", "quote_sha256": "acb1e14aba11493708d9e926778369278e023088fcaa8c118b343392812b714f", "alignment_status": "exact"}}, "candidate_boundary_interpretations": [{"candidate_range": "Split 3b:20-26 (קדמתי בנשף) from 3b:27-4a:7 (ודוד מי הוה ידע פלגא דליליא)", "rationale": "3b:27 opens a fresh question on how David knew exact midnight compared to Moses, though both questions analyze David's midnight rising in Ps 119:62."}], "adjacent_prev_sugya_id": "sugya:bavli:berakhot:3b:17__3b:19", "adjacent_next_sugya_id": "sugya:bavli:berakhot:4a:8__4a:18", "parallel_family_ids": [], "boundary_status": "ambiguous", "review_status": "provisional_ai_double", "uncertainty_notes": "Unified across 3b:20-4a:7 because 4a:4-7 explicitly returns to solve the Moses/David 'כחצות' question posed at 3b:27-29; sub-question split at 3b:27 preserved as candidate."}
